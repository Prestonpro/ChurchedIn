// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CHURCH_ADMIN
  VOLUNTEER
  STUDENT
}

enum EventCategory {
  DINNER
  MENTORSHIP
  COFFEE_CHAT
  STUDY_GROUP
  CULTURAL_OUTING
  AIRPORT_PICKUP
  HOLIDAY_CELEBRATION
  OTHER
}

enum EventStatus {
  PUBLISHED
  CANCELLED
}

enum RsvpRole {
  HELPER
  ATTENDEE
}

enum RsvpStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum MeetingFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum RequestCategory {
  FURNITURE
  FOOD
  MENTORSHIP
  HOUSING
  OTHER
}

// PENDING: targeted at a specific claimer (Mentorship's "browse and pick a
// volunteer" flow) — awaiting that person's accept/decline, same shape as
// the old MentorConnection state machine.
// OPEN: untargeted — any eligible person may claim it (Furniture/Food/
// Housing/Other, and Mentorship too if posted without picking someone),
// same shape as RideRequest.
// Both funnel into CLAIMED, then COMPLETED/CANCELLED — see
// src/lib/requestState.ts for the transition table.
enum RequestStatus {
  PENDING
  OPEN
  CLAIMED
  DECLINED
  COMPLETED
  CANCELLED
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum PartnershipStatus {
  PENDING
  ACCEPTED
}

enum RideStatus {
  OPEN
  CLAIMED
  COMPLETED
  CANCELLED
}

enum RideRequestType {
  GENERAL
  FIRST_VISIT
}

model Church {
  id        String   @id @default(cuid())
  name      String
  city      String?
  joinCode  String   @unique
  createdAt DateTime @default(now())

  // Added for church discovery (Phase 4 of the "Church Discovery, Trust &
  // First-Visit Rides" brief). `joinCode` above already covers the brief's
  // "inviteCode" ask — same concept (shareable, human-friendly code), so
  // there's no second code field. Trust originally had a verification-tier
  // system (community vouching + pastor self-verification); it was removed
  // after the pastor tier turned out to be self-grantable by any church's
  // own creator with no real check — member count (computed on demand, see
  // getChurchProfile/listDiscoverableChurches) is the trust signal now.
  denomination       String?
  languages          String?
  serviceTimes       String?
  bio                String?
  locationLat        Float?
  locationLng        Float?
  address            String?
  website            String?

  // Null means this listing has no real leader yet — e.g. a church seeded
  // directly onto the discovery map so international students can see it
  // exists, before anyone from that church has an account here. Set at
  // creation for every church made through the normal signup/"add a
  // church" flows (its creator is already its CHURCH_ADMIN), and by
  // claimChurchAdminAction the first time an already-joined member claims
  // an unclaimed listing. No real verification yet (see that action's doc
  // comment) — a church-email check is the planned next step.
  claimedAt          DateTime?

  // An explicit, admin-set override for a church seeded onto the discovery
  // map whose real signup count doesn't yet reflect its actual congregation
  // size (e.g. a freshly-seeded large real-world church nobody there has
  // joined this app yet). This is a deliberate, explicit exception to "member
  // count is the trust signal" above — set it only for known-real churches
  // being represented ahead of real adoption, never as a way to make a
  // church look bigger than it is. When null, the real computed count
  // (memberships.length) is used, unchanged from the original design.
  displayMemberCount Int?

  memberships Membership[]
  events      Event[]
  reports     Report[]
  adminInvites ChurchAdminInvite[]
  partnershipsRequested ChurchPartnership[] @relation("PartnershipsRequested")
  partnershipsReceived  ChurchPartnership[] @relation("PartnershipsReceived")
  rideRequests RideRequest[]
  rideOffers RideOffer[]
  conversations Conversation[]
  helpRequests HelpRequest[]
}

/**
 * A cross-church collaboration link between two churches' admin teams —
 * "Collaborate with another church" from the redesign brief. Once ACCEPTED,
 * each side's members can browse (read-only) the other church's published
 * events in a separate "from partner churches" section; RSVPs, the friend
 * directory, and mentor connections stay strictly single-church (the
 * platform's multi-tenancy non-negotiable isn't loosened for this). One
 * admin sends a request by the other church's join code; either side's
 * admin can decline a pending request or end an accepted partnership,
 * which just deletes the row (no history kept — same MVP-simplicity spirit
 * as the rest of this app).
 */
model ChurchPartnership {
  id          String            @id @default(cuid())
  status      PartnershipStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  respondedAt DateTime?

  requestingChurchId String
  requestingChurch   Church @relation("PartnershipsRequested", fields: [requestingChurchId], references: [id])
  partnerChurchId    String
  partnerChurch      Church @relation("PartnershipsReceived", fields: [partnerChurchId], references: [id])

  @@unique([requestingChurchId, partnerChurchId])
  // Both partnership lookups OR over the two directions; the @@unique above
  // only covers the requestingChurchId leg.
  @@index([partnerChurchId])
}

/**
 * An invitation for someone (by email, not yet necessarily a user) to
 * become a CHURCH_ADMIN co-leader — the "you don't have to do this alone"
 * prompt shown right after creating a church. Same hash-at-rest /
 * single-use / expiring pattern as PasswordResetToken. Accepting one
 * creates a Membership with role CHURCH_ADMIN for the invited email,
 * either immediately (if that email already has an account) or once they
 * sign up (see acceptCoAdminInviteAction in src/lib/actions/auth.ts).
 */
model ChurchAdminInvite {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  churchId String
  church   Church @relation(fields: [churchId], references: [id])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Nullable because a Google-only account has no password to check —
  // loginAction must reject email/password attempts against such an account
  // rather than pass null to bcrypt.
  passwordHash String?
  // Set the first time this email signs in via Google; also used to link an
  // existing email/password account to Google on first Google sign-in.
  googleId     String?  @unique
  name         String
  photoUrl     String?
  bio          String?
  // Identity-verification badge shown next to a name wherever it appears
  // to another member (Friends directory, public profile, member list).
  // Deliberately no verification pipeline yet — this is just the display
  // flag; how a user actually gets verified is a future decision. Never
  // self-service: nothing in src/lib/actions sets this today.
  verified     Boolean  @default(false)
  // Whether this user has ever seen the role-aware Help Guide walkthrough
  // (see HelpGuideModal). Auto-shown once, on the first authenticated page
  // render after this is false, then flipped true — never re-shown after
  // that regardless of how many churches they later join. Deliberately on
  // User, not Membership: this is "have you seen the app's own tour", not
  // a per-church thing.
  hasSeenOnboarding Boolean @default(false)
  createdAt    DateTime @default(now())

  // Carried forward from the deleted MentorProfile model — a volunteer's
  // profile content (shown on their public profile page independent of
  // any request/connection state), not tied to the Requests system at
  // all. Field names deliberately match StudentProfile's languages/
  // hobbies/interests/social-link fields so /profile/[userId] can fall
  // back to these directly (`target.studentProfile ?? target`) instead of
  // branching on a second profile model.
  jobTitle     String?
  company      String?
  industry     String?
  languages    String?
  hobbies      String?
  interests    String?
  linkedinUrl  String?
  facebookUrl  String?
  instagramUrl String?
  // Whether this user shows up in the Mentorship directory a student can
  // browse — replaces MentorProfile.openToMentor. Unrelated to whether
  // they can claim OPEN requests in other categories, which has no
  // opt-in flag (mirrors RideRequest: any eligible volunteer can claim).
  openToMentorship Boolean @default(true)

  memberships          Membership[]
  studentProfile       StudentProfile?
  eventsCreated        Event[]            @relation("EventsCreated")
  rsvps                EventRsvp[]
  requestsAsRequester  HelpRequest[]      @relation("RequestsAsRequester")
  requestsAsClaimer    HelpRequest[]      @relation("RequestsAsClaimer")
  messagesSent         Message[]          @relation("MessagesSent")
  reportsFiled         Report[]           @relation("ReportsFiled")
  reportsReceived      Report[]           @relation("ReportsReceived")
  blocksInitiated      Block[]            @relation("BlocksInitiated")
  blocksReceived       Block[]            @relation("BlocksReceived")
  passwordResetTokens  PasswordResetToken[]
  cohostedEvents       EventCohost[]
  rideRequestsAsStudent   RideRequest[] @relation("RideRequestsAsStudent")
  rideRequestsAsVolunteer RideRequest[] @relation("RideRequestsAsVolunteer")
  rideOffersAsVolunteer   RideOffer[]      @relation("RideOffersAsVolunteer")
  rideOfferClaims         RideOfferClaim[] @relation("RideOfferClaimsAsStudent")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  // SHA-256 hash of the token, never the raw value — same principle as
  // password hashing: if this table ever leaks, the hashes alone can't be
  // used to reset anyone's password. The raw token only ever exists in the
  // emailed link and in memory for the single request that validates it.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Reissuing a reset invalidates this user's prior tokens, which filters
  // userId; the @unique above is on tokenHash, so it can't serve that.
  @@index([userId])
}

model Membership {
  id        String   @id @default(cuid())
  role      Role
  createdAt DateTime @default(now())
  // Stamped whenever this member visits /events — lets the nav show a
  // small "something's new" dot on the Events link by comparing against
  // Event.createdAt, without a dedicated read/unread tracking table.
  lastSeenEventsAt DateTime?

  userId   String
  user     User   @relation(fields: [userId], references: [id])
  churchId String
  church   Church @relation(fields: [churchId], references: [id])

  @@unique([userId, churchId])
  // A btree on (userId, churchId) cannot serve a churchId-only filter, and
  // that's the shape used by all four dashboards' member counts, the role
  // groupBy, listMembersForChurch, getChurchProfile, and the new-event email
  // fan-out. Easy to assume the @@unique above already covered this; it
  // doesn't, because churchId isn't the leading column.
  @@index([churchId])
}

model StudentProfile {
  id              String  @id @default(cuid())
  countryOfOrigin String?
  school          String?
  major           String?
  graduationYear  String?
  languages       String?
  hobbies         String?
  interests       String?
  careerGoals     String?
  linkedinUrl     String?
  facebookUrl     String?
  instagramUrl    String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Event {
  id           String        @id @default(cuid())
  title        String
  description  String
  category     EventCategory
  startsAt     DateTime
  endsAt       DateTime
  location     String
  isVirtual    Boolean       @default(false)
  // Signals the host wants to use the church building (their home isn't
  // big enough, etc.) — a flag for the church leader to notice, not an
  // actual booking/reservation system.
  atChurch     Boolean       @default(false)
  // Optional geolocation for the interactive event map (/events/map) and
  // the event detail page's mini-map. Distinct from `location` above
  // (which stays the required free-text description shown everywhere
  // else) — `address` is specifically the human-readable string paired
  // with the lat/lng pin, filled in only when a creator uses the map
  // location picker. All three are null together or set together.
  locationLat Float?
  locationLng Float?
  address     String?
  volunteerCap Int?
  studentCap   Int?
  status       EventStatus   @default(PUBLISHED)
  createdAt    DateTime      @default(now())

  churchId    String
  church      Church @relation(fields: [churchId], references: [id])
  createdById String
  createdBy   User   @relation("EventsCreated", fields: [createdById], references: [id])

  rsvps   EventRsvp[]
  cohosts EventCohost[]

  // The event feed, calendar, and map all filter churchId + status and range
  // over startsAt.
  @@index([churchId, status, startsAt])
  // hasUnseenEvents (queries.ts) counts churchId + status with a createdAt
  // lower bound, and runs on *every* authenticated page render via AuthShell's
  // nav badge — a different range column from the index above, so it needs its
  // own rather than reusing it.
  @@index([churchId, createdAt])
  // The reminder cron scans startsAt across every church, unscoped.
  @@index([startsAt])
  // "Events I'm hosting" on the volunteer dashboard.
  @@index([createdById])
}

/**
 * A volunteer invited to co-host someone else's event — gets the same
 * visibility as the creator (sees the RSVP list, can edit description/
 * details) but never cancel/delete rights, which stay creator-only.
 * Being added is immediate, no accept/decline step (see inviteCohostAction
 * in src/lib/actions/events.ts for the same-church + VOLUNTEER-role checks
 * enforced before a row here can ever be created).
 */
model EventCohost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  // `cohosts: { some: { userId } }` on the volunteer dashboard and
  // `cohostedEvents: { none: { eventId } }` in listCohostCandidates both filter
  // userId alone, which the eventId-leading @@unique can't serve.
  @@index([userId])
}

model EventRsvp {
  id        String     @id @default(cuid())
  role      RsvpRole
  status    RsvpStatus @default(CONFIRMED)
  createdAt DateTime   @default(now())
  // Null until the day-before reminder cron sends one — per-RSVP rather
  // than per-event so a late RSVP (already inside the reminder window when
  // it's made) is never falsely treated as "already reminded", and a
  // cancelled-then-re-RSVP'd attendee can be reminded again.
  reminderSentAt DateTime?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  // "My RSVPs" on the student dashboard filters userId + status. The
  // eventId-leading @@unique already covers the per-event capacity counts.
  @@index([userId, status])
}

/**
 * The messaging thread for one CLAIMED (or since-COMPLETED/CANCELLED)
 * HelpRequest — a 1:1 pairing, not a separate permission object. The
 * request itself is the source of truth for whether messaging is allowed
 * at all (claiming/accepting a request creates this row, alongside the
 * existing contact-info-reveal emails); this table only holds the
 * conversation container and its messages.
 *
 * `requesterId`/`claimerId`/`churchId` are denormalized off the request at
 * creation time rather than read through it on every check — same
 * reasoning as before the rekey: a HelpRequest's requesterId/claimerId
 * never change after creation, and it turns "list my conversations"/"my
 * unread count" — both hot paths, the unread count runs on every
 * authenticated page render via the nav badge — into a flat filter
 * instead of a join through `request` each time. Unlike the old
 * MentorConnection, HelpRequest already carries its own churchId, so
 * there's no cross-membership lookup needed to fill this in.
 */
model Conversation {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  // Bumped on every new message so the "my conversations" list can sort by
  // recency without aggregating over Message.
  lastMessageAt DateTime @default(now())

  requestId String      @unique
  request   HelpRequest @relation(fields: [requestId], references: [id])

  requesterId String
  claimerId   String
  churchId    String
  church      Church @relation(fields: [churchId], references: [id])

  messages Message[]
  reports  Report[]

  @@index([requesterId, lastMessageAt])
  @@index([claimerId, lastMessageAt])
}

model Message {
  id        String    @id @default(cuid())
  body      String
  createdAt DateTime  @default(now())
  // Null until the recipient opens the thread — see markConversationReadAction.
  // Per-message rather than a per-participant read cursor so an unread count
  // is a plain count and marking read is idempotent, the same reasoning
  // EventRsvp.reminderSentAt uses for per-row tracking over a single cursor.
  readAt    DateTime?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  // Powers both markConversationReadAction (readAt: null, senderId != viewer)
  // and the unread-count check (same shape, viewer-wide instead of one thread).
  @@index([conversationId, senderId, readAt])
}

/**
 * A generalized help request — replaces the old Friends/mentor-matching
 * feature (MentorProfile/MentorConnection) with a category-based system
 * (Furniture/Food/Mentorship/Housing/Other). Named HelpRequest, not
 * Request, since `Request` is a global TS/DOM type used throughout this
 * app's own route handlers — shadowing it would be a constant, avoidable
 * source of friction.
 *
 * One state machine serves two distinct UX flows, so there's no
 * category-special-casing here or in src/lib/requestState.ts:
 *   - Blind claim (Furniture/Food/Housing/Other, and Mentorship too if
 *     posted without picking someone): created OPEN, claimerId null,
 *     OPEN --CLAIM--> CLAIMED. Same shape as RideRequest.
 *   - Targeted pick (Mentorship's browsable-directory flow): created
 *     PENDING with claimerId already set to the chosen volunteer,
 *     PENDING --ACCEPT--> CLAIMED, PENDING --DECLINE--> DECLINED. Same
 *     shape as the old MentorConnection.
 * Either way: CLAIMED --COMPLETE--> COMPLETED; CANCEL is reachable from
 * PENDING/OPEN/CLAIMED --> CANCELLED.
 *
 * Same contact-info safety rule as ride requests and the old mentor
 * connections: the requester's and claimer's contact info is only shown
 * to each other once CLAIMED — see requestContactVisible() in
 * src/lib/requestState.ts, enforced at the query layer.
 */
model HelpRequest {
  id          String          @id @default(cuid())
  category    RequestCategory
  title       String
  description String?
  status      RequestStatus
  createdAt   DateTime        @default(now())
  respondedAt DateTime?

  requesterId String
  requester   User    @relation("RequestsAsRequester", fields: [requesterId], references: [id])
  claimerId   String?
  claimer     User?   @relation("RequestsAsClaimer", fields: [claimerId], references: [id])
  churchId    String
  church      Church  @relation(fields: [churchId], references: [id])

  meetingPlan  RequestMeetingPlan?
  conversation Conversation?

  @@index([churchId, status, category, createdAt])
  @@index([requesterId])
  @@index([claimerId])
}

/**
 * A private, informal recurring-meeting note attached to a CLAIMED
 * HelpRequest — the "mentor sets up a bi-weekly/monthly standing meeting
 * with a mentee" behavior from real mentor feedback, which the public
 * Event/RSVP system isn't the right fit for (no audience, capacity, or
 * waitlist involved, just the two matched people). Not restricted to the
 * Mentorship category at the schema level, though that's the only one the
 * UI surfaces it for today. Either person can set or edit it directly —
 * no separate propose/accept step, same trust-it-for-now spirit as the
 * rest of this app. Calendar invites/reminders are intentionally out of
 * scope for now; this is a shared note, not a scheduling system.
 */
model RequestMeetingPlan {
  id        String           @id @default(cuid())
  frequency MeetingFrequency
  dayOfWeek Int?
  time      String?
  notes     String?
  updatedAt DateTime         @updatedAt

  requestId String      @unique
  request   HelpRequest @relation(fields: [requestId], references: [id])
}

/**
 * A student's ask for a ride (airport pickup, store run, etc.) that any
 * volunteer at the same church can claim. Modeled after MentorConnection's
 * shape (a studentId/volunteerId pair with a status enum) but simpler —
 * there's no decline/re-request dance, just OPEN until a volunteer claims
 * it. Same contact-info safety rule as mentor connections: the student's
 * and volunteer's contact info is only shown to each other once claimed —
 * see rideContactVisible() in src/lib/rideState.ts, enforced at the query
 * layer the same way connectionState.ts's contactInfoVisible() is.
 */
model RideRequest {
  id          String     @id @default(cuid())
  destination String
  date        DateTime
  time        String
  notes       String?
  // Lets a student flag that they'd rather ride along with other students
  // than go one-on-one with a volunteer — purely informational for now
  // (shown to volunteers browsing the board), doesn't change the claim
  // flow or steer them toward a RideOffer automatically.
  prefersGroupRide Boolean @default(false)
  status      RideStatus @default(OPEN)
  // GENERAL: a student asking their own church's volunteers for a ride.
  // FIRST_VISIT: someone (not necessarily a member of `churchId` at all —
  // see createFirstVisitRideRequestAction) asking for a ride to visit a
  // church they found on /discover. `churchId` is always the *destination*
  // church either way; for FIRST_VISIT it's specifically NOT derived from
  // the requester's own membership, since they may not have one anywhere.
  type        RideRequestType @default(GENERAL)
  createdAt   DateTime   @default(now())

  studentId String
  student   User   @relation("RideRequestsAsStudent", fields: [studentId], references: [id])
  volunteerId String?
  volunteer   User?   @relation("RideRequestsAsVolunteer", fields: [volunteerId], references: [id])
  churchId  String
  church    Church @relation(fields: [churchId], references: [id])

  // RideRequest has no unique constraint anywhere, so before these it had no
  // secondary index at all and every rides query was a full table scan.
  @@index([churchId, status, date])
  @@index([studentId])
  @@index([volunteerId])
}

/**
 * The inverse of RideRequest: a volunteer proactively offering a ride to
 * church at a set date/time with a fixed number of seats, instead of
 * waiting for a student to ask. Capacity/waitlist behavior is deliberately
 * the same as event RSVPs — decideRsvpStatus/pickPromotionCandidate in
 * src/lib/rsvp.ts are reused as-is for RideOfferClaim, rather than
 * reinventing a second capacity system.
 */
model RideOffer {
  id          String    @id @default(cuid())
  date        DateTime
  time        String
  capacity    Int
  notes       String?
  // Whole-offer cancellation by the volunteer — distinct from a single
  // rider cancelling their own claim. Nullable timestamp, same idiom as
  // ChurchAdminInvite.usedAt/PasswordResetToken.usedAt, rather than a
  // dedicated enum for what's just a binary state.
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  volunteerId String
  volunteer   User   @relation("RideOffersAsVolunteer", fields: [volunteerId], references: [id])
  churchId    String
  church      Church @relation(fields: [churchId], references: [id])

  claims RideOfferClaim[]

  @@index([churchId, date])
  @@index([volunteerId])
}

/**
 * A student's claimed seat on a RideOffer. Reuses RsvpStatus
 * (CONFIRMED/WAITLISTED/CANCELLED) rather than a new enum — the semantics
 * are identical to an EventRsvp row, just against a ride offer's capacity
 * instead of an event's.
 */
model RideOfferClaim {
  id        String     @id @default(cuid())
  status    RsvpStatus @default(CONFIRMED)
  createdAt DateTime   @default(now())

  rideOfferId String
  rideOffer   RideOffer @relation(fields: [rideOfferId], references: [id])
  studentId   String
  student     User      @relation("RideOfferClaimsAsStudent", fields: [studentId], references: [id])

  @@unique([rideOfferId, studentId])
  @@index([studentId])
}

model Block {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  blockerId String
  blocker   User   @relation("BlocksInitiated", fields: [blockerId], references: [id])
  blockedId String
  blocked   User   @relation("BlocksReceived", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  // blockedPairUserIds ORs both directions; the @@unique above only covers the
  // blockerId leg. This runs on every RSVP, every connection request, every
  // friend-directory load, and now every rides-board load too.
  @@index([blockedId])
}

model Report {
  id        String       @id @default(cuid())
  reason    String
  details   String?
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())

  churchId String
  church   Church @relation(fields: [churchId], references: [id])

  reportedById String
  reportedBy   User   @relation("ReportsFiled", fields: [reportedById], references: [id])

  reportedUserId String?
  reportedUser   User?   @relation("ReportsReceived", fields: [reportedUserId], references: [id])

  eventId String?

  // A message-thread report — reportConversationAction. Nullable since
  // eventId above is (unwired) provision for a future event-report flow;
  // this is the first Report producer this app actually has.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  // The admin review queue filters churchId + status.
  @@index([churchId, status])
}
