// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CHURCH_ADMIN
  VOLUNTEER
  STUDENT
}

enum EventCategory {
  DINNER
  MENTORSHIP
  COFFEE_CHAT
  STUDY_GROUP
  CULTURAL_OUTING
  AIRPORT_PICKUP
  HOLIDAY_CELEBRATION
  OTHER
}

enum EventStatus {
  PUBLISHED
  CANCELLED
}

enum RsvpRole {
  HELPER
  ATTENDEE
}

enum RsvpStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  ENDED
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum PartnershipStatus {
  PENDING
  ACCEPTED
}

enum RideStatus {
  OPEN
  CLAIMED
  COMPLETED
  CANCELLED
}

enum RideRequestType {
  GENERAL
  FIRST_VISIT
}

model Church {
  id        String   @id @default(cuid())
  name      String
  city      String?
  joinCode  String   @unique
  createdAt DateTime @default(now())

  // Added for church discovery (Phase 4 of the "Church Discovery, Trust &
  // First-Visit Rides" brief). `joinCode` above already covers the brief's
  // "inviteCode" ask — same concept (shareable, human-friendly code), so
  // there's no second code field. Trust originally had a verification-tier
  // system (community vouching + pastor self-verification); it was removed
  // after the pastor tier turned out to be self-grantable by any church's
  // own creator with no real check — member count (computed on demand, see
  // getChurchProfile/listDiscoverableChurches) is the trust signal now.
  denomination       String?
  languages          String?
  serviceTimes       String?
  bio                String?
  locationLat        Float?
  locationLng        Float?
  address            String?
  website            String?

  memberships Membership[]
  events      Event[]
  reports     Report[]
  adminInvites ChurchAdminInvite[]
  partnershipsRequested ChurchPartnership[] @relation("PartnershipsRequested")
  partnershipsReceived  ChurchPartnership[] @relation("PartnershipsReceived")
  rideRequests RideRequest[]
}

/**
 * A cross-church collaboration link between two churches' admin teams —
 * "Collaborate with another church" from the redesign brief. Once ACCEPTED,
 * each side's members can browse (read-only) the other church's published
 * events in a separate "from partner churches" section; RSVPs, the friend
 * directory, and mentor connections stay strictly single-church (the
 * platform's multi-tenancy non-negotiable isn't loosened for this). One
 * admin sends a request by the other church's join code; either side's
 * admin can decline a pending request or end an accepted partnership,
 * which just deletes the row (no history kept — same MVP-simplicity spirit
 * as the rest of this app).
 */
model ChurchPartnership {
  id          String            @id @default(cuid())
  status      PartnershipStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  respondedAt DateTime?

  requestingChurchId String
  requestingChurch   Church @relation("PartnershipsRequested", fields: [requestingChurchId], references: [id])
  partnerChurchId    String
  partnerChurch      Church @relation("PartnershipsReceived", fields: [partnerChurchId], references: [id])

  @@unique([requestingChurchId, partnerChurchId])
}

/**
 * An invitation for someone (by email, not yet necessarily a user) to
 * become a CHURCH_ADMIN co-leader — the "you don't have to do this alone"
 * prompt shown right after creating a church. Same hash-at-rest /
 * single-use / expiring pattern as PasswordResetToken. Accepting one
 * creates a Membership with role CHURCH_ADMIN for the invited email,
 * either immediately (if that email already has an account) or once they
 * sign up (see acceptCoAdminInviteAction in src/lib/actions/auth.ts).
 */
model ChurchAdminInvite {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  churchId String
  church   Church @relation(fields: [churchId], references: [id])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Nullable because a Google-only account has no password to check —
  // loginAction must reject email/password attempts against such an account
  // rather than pass null to bcrypt.
  passwordHash String?
  // Set the first time this email signs in via Google; also used to link an
  // existing email/password account to Google on first Google sign-in.
  googleId     String?  @unique
  name         String
  photoUrl     String?
  bio          String?
  createdAt    DateTime @default(now())

  memberships          Membership[]
  mentorProfile        MentorProfile?
  studentProfile       StudentProfile?
  eventsCreated        Event[]            @relation("EventsCreated")
  rsvps                EventRsvp[]
  connectionsAsStudent MentorConnection[] @relation("ConnectionsAsStudent")
  connectionsAsMentor  MentorConnection[] @relation("ConnectionsAsMentor")
  reportsFiled         Report[]           @relation("ReportsFiled")
  reportsReceived      Report[]           @relation("ReportsReceived")
  blocksInitiated      Block[]            @relation("BlocksInitiated")
  blocksReceived       Block[]            @relation("BlocksReceived")
  passwordResetTokens  PasswordResetToken[]
  cohostedEvents       EventCohost[]
  rideRequestsAsStudent   RideRequest[] @relation("RideRequestsAsStudent")
  rideRequestsAsVolunteer RideRequest[] @relation("RideRequestsAsVolunteer")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  // SHA-256 hash of the token, never the raw value — same principle as
  // password hashing: if this table ever leaks, the hashes alone can't be
  // used to reset anyone's password. The raw token only ever exists in the
  // emailed link and in memory for the single request that validates it.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Membership {
  id        String   @id @default(cuid())
  role      Role
  createdAt DateTime @default(now())
  // Stamped whenever this member visits /events — lets the nav show a
  // small "something's new" dot on the Events link by comparing against
  // Event.createdAt, without a dedicated read/unread tracking table.
  lastSeenEventsAt DateTime?

  userId   String
  user     User   @relation(fields: [userId], references: [id])
  churchId String
  church   Church @relation(fields: [churchId], references: [id])

  @@unique([userId, churchId])
}

model MentorProfile {
  id           String  @id @default(cuid())
  languages    String?
  interests    String?
  openToMentor Boolean @default(true)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model StudentProfile {
  id              String  @id @default(cuid())
  countryOfOrigin String?
  school          String?
  languages       String?
  interests       String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Event {
  id           String        @id @default(cuid())
  title        String
  description  String
  category     EventCategory
  startsAt     DateTime
  endsAt       DateTime
  location     String
  isVirtual    Boolean       @default(false)
  // Signals the host wants to use the church building (their home isn't
  // big enough, etc.) — a flag for the church leader to notice, not an
  // actual booking/reservation system.
  atChurch     Boolean       @default(false)
  // Optional geolocation for the interactive event map (/events/map) and
  // the event detail page's mini-map. Distinct from `location` above
  // (which stays the required free-text description shown everywhere
  // else) — `address` is specifically the human-readable string paired
  // with the lat/lng pin, filled in only when a creator uses the map
  // location picker. All three are null together or set together.
  locationLat Float?
  locationLng Float?
  address     String?
  volunteerCap Int?
  studentCap   Int?
  status       EventStatus   @default(PUBLISHED)
  createdAt    DateTime      @default(now())

  churchId    String
  church      Church @relation(fields: [churchId], references: [id])
  createdById String
  createdBy   User   @relation("EventsCreated", fields: [createdById], references: [id])

  rsvps   EventRsvp[]
  cohosts EventCohost[]
}

/**
 * A volunteer invited to co-host someone else's event — gets the same
 * visibility as the creator (sees the RSVP list, can edit description/
 * details) but never cancel/delete rights, which stay creator-only.
 * Being added is immediate, no accept/decline step (see inviteCohostAction
 * in src/lib/actions/events.ts for the same-church + VOLUNTEER-role checks
 * enforced before a row here can ever be created).
 */
model EventCohost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model EventRsvp {
  id        String     @id @default(cuid())
  role      RsvpRole
  status    RsvpStatus @default(CONFIRMED)
  createdAt DateTime   @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model MentorConnection {
  id              String           @id @default(cuid())
  status          ConnectionStatus @default(PENDING)
  message         String?
  createdAt       DateTime         @default(now())
  lastRequestedAt DateTime         @default(now())
  respondedAt     DateTime?

  studentId String
  student   User   @relation("ConnectionsAsStudent", fields: [studentId], references: [id])
  mentorId  String
  mentor    User   @relation("ConnectionsAsMentor", fields: [mentorId], references: [id])

  @@unique([studentId, mentorId])
}

/**
 * A student's ask for a ride (airport pickup, store run, etc.) that any
 * volunteer at the same church can claim. Modeled after MentorConnection's
 * shape (a studentId/volunteerId pair with a status enum) but simpler —
 * there's no decline/re-request dance, just OPEN until a volunteer claims
 * it. Same contact-info safety rule as mentor connections: the student's
 * and volunteer's contact info is only shown to each other once claimed —
 * see rideContactVisible() in src/lib/rideState.ts, enforced at the query
 * layer the same way connectionState.ts's contactInfoVisible() is.
 */
model RideRequest {
  id          String     @id @default(cuid())
  destination String
  date        DateTime
  time        String
  notes       String?
  status      RideStatus @default(OPEN)
  // GENERAL: a student asking their own church's volunteers for a ride.
  // FIRST_VISIT: someone (not necessarily a member of `churchId` at all —
  // see createFirstVisitRideRequestAction) asking for a ride to visit a
  // church they found on /discover. `churchId` is always the *destination*
  // church either way; for FIRST_VISIT it's specifically NOT derived from
  // the requester's own membership, since they may not have one anywhere.
  type        RideRequestType @default(GENERAL)
  createdAt   DateTime   @default(now())

  studentId String
  student   User   @relation("RideRequestsAsStudent", fields: [studentId], references: [id])
  volunteerId String?
  volunteer   User?   @relation("RideRequestsAsVolunteer", fields: [volunteerId], references: [id])
  churchId  String
  church    Church @relation(fields: [churchId], references: [id])
}

model Block {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  blockerId String
  blocker   User   @relation("BlocksInitiated", fields: [blockerId], references: [id])
  blockedId String
  blocked   User   @relation("BlocksReceived", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

model Report {
  id        String       @id @default(cuid())
  reason    String
  details   String?
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())

  churchId String
  church   Church @relation(fields: [churchId], references: [id])

  reportedById String
  reportedBy   User   @relation("ReportsFiled", fields: [reportedById], references: [id])

  reportedUserId String?
  reportedUser   User?   @relation("ReportsReceived", fields: [reportedUserId], references: [id])

  eventId String?
}
