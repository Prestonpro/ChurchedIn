+import { ChatsCircle, ListChecks, LockKey, Ticket, X, Check } from "@phosphor-icons/react/dist/ssr";
+import { Reveal } from "@/components/Reveal";
+
+/**
+ * "We already have a WhatsApp group" is the objection every church we
+ * demoed to raised, and the Demo Day note was that we should meet it head
+ * on rather than pretend it isn't the incumbent: lead with the three things
+ * a group chat structurally cannot do. Not a feature grid — each row is a
+ * specific moment where the group chat breaks down, then what happens here
+ * instead.
+ */
+const CONTRASTS = [
+  {
+    iconKey: "waitlist",
+    moment: "A dinner for eight fills up",
+    groupChat:
+      "Fourteen people reply yes. Someone has to count the messages, then tell six of them no by hand — and redo it every time a family drops out.",
+    churchedIn:
+      "The ninth RSVP joins a waitlist automatically, and the longest-waiting person is promoted the moment someone cancels. Helpers and attendees have separate headcounts.",
+  },
+  {
+    iconKey: "privacy",
+    moment: "A student wants one person to talk to",
+    groupChat:
+      "Adding them to the group hands their phone number to everyone in it, and they still have to work out who to message first.",
+    churchedIn:
+      "They browse a friend directory by language and interest and send one reach-out. Neither side's contact info appears until both people have accepted.",
+  },
+  {
+    iconKey: "handoff",
+    moment: "A new volunteer joins, or a leader moves away",
+    groupChat:
+      "Somebody with admin rights has to add them by phone number, and when the person holding the group leaves, the history and the roster leave with them.",
+    churchedIn:
+      "A six-character join code lets anyone join your church's own space, with roles, a roster, and co-hosts who can cover for each other — it outlasts whoever set it up.",
+  },
+] as const;
+
+const ICONS = {
+  waitlist: ListChecks,
+  privacy: LockKey,
+  handoff: Ticket,
+} as const;
+
+export function BeyondGroupChat() {
+  return (
