+      school: "Texas A&M University",
+      languages: "Tamil, Hindi, English",
+      interests: "Gardening, classical music, badminton",
+    },
+    joinedHoursAgo: 5 * 24,
+  },
+  {
+    key: "mehdi",
+    name: "Mehdi Karimi",
+    role: "STUDENT",
+    // The most recent join, so the activity feed opens on someone brand new —
+    // which is what a reviewer should see first.
+    bio: "Just landed for a computer science master's. Knows nobody yet.",
+    student: {
+      countryOfOrigin: "Iran",
+      school: "Texas A&M University",
+      languages: "Persian, English",
+      interests: "Chess, hiking, cooking",
+    },
+    joinedHoursAgo: 20,
+  },
+];
+
+/**
+ * Refuses to reset anything that isn't unmistakably this script's own demo
+ * church: right join code, and every single member on a demo email address.
+ * The join code alphabet can produce "DEMO24" by chance for a real church,
+ * and wiping a real congregation's gatherings because of a collision is not
+ * a recoverable mistake.
+ */
+async function assertIsDemoChurch(churchId: string): Promise<void> {
+  const members = await prisma.membership.findMany({
+    where: { churchId },
+    include: { user: { select: { email: true } } },
+  });
+  const foreign = members.filter((m) => !m.user.email.endsWith(`@${DEMO_EMAIL_DOMAIN}`));
+  if (foreign.length > 0) {
+    throw new Error(
+      `A church already uses the join code ${DEMO_JOIN_CODE} and has ${foreign.length} member(s) ` +
+        `outside @${DEMO_EMAIL_DOMAIN}. Refusing to touch it — change DEMO_JOIN_CODE in ` +
+        `prisma/seed.ts and re-run.`,
+    );
+  }
+}
+
+/** Removes the demo church and everything hanging off it, in FK-safe order. */
+async function resetDemoChurch(): Promise<void> {
+  const church = await prisma.church.findUnique({ where: { joinCode: DEMO_JOIN_CODE } });
+  if (!church) return;
+
+  await assertIsDemoChurch(church.id);
+  console.log(`Resetting the existing demo church (${church.name})…`);
+
+  const memberships = await prisma.membership.findMany({ where: { churchId: church.id } });
+  const userIds = memberships.map((m) => m.userId);
+
+  await prisma.$transaction([
+    prisma.eventRsvp.deleteMany({ where: { event: { churchId: church.id } } }),
+    prisma.eventCohost.deleteMany({ where: { event: { churchId: church.id } } }),
+    prisma.report.deleteMany({ where: { churchId: church.id } }),
+    prisma.event.deleteMany({ where: { churchId: church.id } }),
+    prisma.volunteerStory.deleteMany({ where: { churchId: church.id } }),
+    prisma.rideRequest.deleteMany({ where: { churchId: church.id } }),
+    prisma.churchAdminInvite.deleteMany({ where: { churchId: church.id } }),
+    prisma.churchPartnership.deleteMany({
+      where: {
+        OR: [{ requestingChurchId: church.id }, { partnerChurchId: church.id }],
+      },
+    }),
+    // Scoped to demo users specifically: these tables aren't church-scoped,
+    // so filtering by churchId isn't an option and filtering by user is.
+    prisma.mentorConnection.deleteMany({
+      where: { OR: [{ studentId: { in: userIds } }, { mentorId: { in: userIds } }] },
+    }),
+    prisma.block.deleteMany({
+      where: { OR: [{ blockerId: { in: userIds } }, { blockedId: { in: userIds } }] },
+    }),
+    prisma.passwordResetToken.deleteMany({ where: { userId: { in: userIds } } }),
+    prisma.mentorProfile.deleteMany({ where: { userId: { in: userIds } } }),
+    prisma.studentProfile.deleteMany({ where: { userId: { in: userIds } } }),
+    prisma.membership.deleteMany({ where: { churchId: church.id } }),
+    prisma.user.deleteMany({ where: { id: { in: userIds } } }),
+    prisma.church.delete({ where: { id: church.id } }),
+  ]);
+}
+
+async function main() {
+  await resetDemoChurch();
+
+  const passwordHash = await bcrypt.hash(DEMO_PASSWORD, 10);
+
+  const church = await prisma.church.create({
+    data: {
+      name: "Maple Street Fellowship",
+      city: "College Station, TX",
+      joinCode: DEMO_JOIN_CODE,
+      denomination: "Non-denominational",
+      languages: "English, Mandarin, Spanish",
+      serviceTimes: "Sundays 9:30am & 11am",
+      bio:
+        "A demo church used to show ChurchedIn with real-looking data. Everyone here is " +
+        "fictional. We host a dinner most months, coffee before finals, and airport pickups " +
+        "at the start of each semester.",
+      locationLat: 30.6188,
+      locationLng: -96.3365,
+      address: "410 Maple Street, College Station, TX 77840",
+      website: "https://example.org/maple-street",
+      // The demo church has a real leader from the moment it exists, so it
+      // must not show the "Not yet claimed" badge or offer the claim flow.
+      claimedAt: hoursAgo(70 * 24),
+    },
+  });
+
+  const users: Record<string, { id: string; name: string }> = {};
+  for (const person of PEOPLE) {
+    const user = await prisma.user.create({
+      data: {
+        email: `${person.key}@${DEMO_EMAIL_DOMAIN}`,
+        name: person.name,
+        bio: person.bio,
