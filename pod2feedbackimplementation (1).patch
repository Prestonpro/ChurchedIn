diff --git a/src/lib/actions/stories.ts b/src/lib/actions/stories.ts
new file mode 100644
index 0000000..f0bfc47
--- /dev/null
+++ b/src/lib/actions/stories.ts
@@ -0,0 +1,102 @@
+"use server";
+
+import { revalidatePath } from "next/cache";
+import { prisma } from "@/lib/prisma";
+import { requireUser } from "@/lib/auth";
+import { ROLES } from "@/lib/constants";
+import { volunteerStorySchema, firstIssueMessage } from "@/lib/validation";
+
+export type ActionResult = { error: string } | { ok: true } | void;
+
+/** VOLUNTEER and CHURCH_ADMIN members can write; see the VolunteerStory doc
+ * comment in schema.prisma for why students deliberately can't yet. */
+const AUTHOR_ROLES: string[] = [ROLES.VOLUNTEER, ROLES.CHURCH_ADMIN];
+
+export async function createVolunteerStoryAction(
+  _prev: ActionResult,
+  formData: FormData,
+): Promise<ActionResult> {
+  const user = await requireUser();
+  const membership = user.activeMembership;
+  if (!membership) {
+    return { error: "Join a church before sharing a story." };
+  }
+  if (!AUTHOR_ROLES.includes(membership.role)) {
+    return { error: "Only volunteers and church leaders can share a story right now." };
+  }
+
+  const parsed = volunteerStorySchema.safeParse({
+    body: formData.get("body"),
+    // An unchecked checkbox sends nothing at all, so absence is a decisive
+    // "no" here — never default this to true.
+    sharePublicly: formData.get("sharePublicly") === "on",
+  });
+  if (!parsed.success) {
+    return { error: firstIssueMessage(parsed.error) };
+  }
+
+  await prisma.volunteerStory.create({
+    data: {
+      body: parsed.data.body,
+      sharePublicly: parsed.data.sharePublicly,
+      churchId: membership.churchId,
+      authorId: user.id,
+    },
+  });
+
+  revalidatePath("/stories");
+  revalidatePath(`/churches/${membership.churchId}`);
+  return { ok: true };
+}
+
+/**
+ * Deletes a story. The author can always remove their own; a CHURCH_ADMIN of
+ * the same church can also remove one, since they're accountable for what
+ * shows up on their church's public page and there's no edit/report flow for
+ * stories yet.
+ */
+export async function deleteVolunteerStoryAction(storyId: string): Promise<ActionResult> {
+  const user = await requireUser();
+  const story = await prisma.volunteerStory.findUnique({ where: { id: storyId } });
+  if (!story) {
+    return { error: "That story no longer exists." };
+  }
+
+  const isAuthor = story.authorId === user.id;
+  const isChurchAdmin = user.memberships.some(
+    (m) => m.churchId === story.churchId && m.role === ROLES.CHURCH_ADMIN,
+  );
+  if (!isAuthor && !isChurchAdmin) {
+    return { error: "You can only remove your own story." };
+  }
+
+  await prisma.volunteerStory.delete({ where: { id: storyId } });
+
+  revalidatePath("/stories");
+  revalidatePath(`/churches/${story.churchId}`);
+}
+
+/**
+ * Flips whether a story shows on the church's public profile page. Author
+ * only — an admin can remove a story they're uncomfortable with (above), but
+ * shouldn't be able to publish someone else's words to a public page under
+ * their name without asking.
+ */
+export async function toggleStoryVisibilityAction(storyId: string): Promise<ActionResult> {
+  const user = await requireUser();
+  const story = await prisma.volunteerStory.findUnique({ where: { id: storyId } });
+  if (!story) {
+    return { error: "That story no longer exists." };
+  }
+  if (story.authorId !== user.id) {
+    return { error: "Only the person who wrote a story can change where it shows." };
+  }
+
+  await prisma.volunteerStory.update({
+    where: { id: storyId },
+    data: { sharePublicly: !story.sharePublicly },
+  });
+
+  revalidatePath("/stories");
+  revalidatePath(`/churches/${story.churchId}`);
+}
