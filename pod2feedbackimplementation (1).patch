+"use client";
+
+import { useState } from "react";
+import Link from "next/link";
+import {
+  ArrowClockwise,
+  ArrowRight,
+  CheckCircle,
+  Circle,
+  Compass,
+  Lightbulb,
+  Path,
+  SealCheck,
+} from "@phosphor-icons/react/dist/ssr";
+import { Card } from "@/components/ui/Card";
+import { Badge } from "@/components/ui/Badge";
+import { Button, LinkButton } from "@/components/ui/Button";
+import {
+  QUESTIONS,
+  TIER_ORDER,
+  TIER_CONTENT,
+  DIMENSION_LABELS,
+  classifyReadiness,
+  isComplete,
+  leadershipNote,
+  type Answers,
+} from "@/lib/readiness";
+
+/**
+ * The Readiness Pathway assessment. Entirely client-side and unpersisted on
+ * purpose: a church shouldn't need an account to find out it isn't ready for
+ * one yet, and there's nothing here worth storing about a church that hasn't
+ * agreed to be stored. All the scoring rules live in src/lib/readiness.ts so
+ * they're unit-tested rather than tangled up with the UI.
+ */
+export function ReadinessAssessment() {
+  const [answers, setAnswers] = useState<Answers>({});
+  const [submitted, setSubmitted] = useState(false);
+
+  const complete = isComplete(answers);
+  const answeredCount = QUESTIONS.filter((q) => typeof answers[q.id] === "number").length;
+
+  function choose(questionId: string, optionIndex: number) {
+    setAnswers((prev) => ({ ...prev, [questionId]: optionIndex }));
+  }
+
+  function reset() {
+    setAnswers({});
+    setSubmitted(false);
+    // Send focus back to the top of the assessment rather than leaving the
+    // reader wherever the (now unmounted) result card used to be.
+    document.getElementById("assessment")?.scrollIntoView({ behavior: "smooth", block: "start" });
+  }
+
+  if (submitted && complete) {
+    return <Result answers={answers} onReset={reset} />;
+  }
+
+  return (
+    <div id="assessment" className="scroll-mt-24">
+      <div className="mb-6 flex items-center justify-between gap-4">
+        <p className="text-sm font-semibold text-ink-soft">
+          {answeredCount} of {QUESTIONS.length} answered
+        </p>
+        <div
+          className="h-1.5 w-40 overflow-hidden rounded-full bg-line"
+          role="progressbar"
+          aria-valuenow={answeredCount}
+          aria-valuemin={0}
+          aria-valuemax={QUESTIONS.length}
+          aria-label="Assessment progress"
+        >
+          <div
+            className="h-full rounded-full bg-brand-500 transition-brand"
+            style={{ width: `${(answeredCount / QUESTIONS.length) * 100}%` }}
+          />
+        </div>
+      </div>
+
+      <div className="space-y-4">
+        {QUESTIONS.map((question, index) => (
+          <Card key={question.id}>
+            <fieldset>
+              <legend className="flex gap-3 text-base font-bold text-ink">
+                <span className="flex size-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-xs font-extrabold text-brand-700">
+                  {index + 1}
+                </span>
+                {question.prompt}
+              </legend>
+              <div className="mt-4 space-y-2 sm:pl-9">
+                {question.options.map((option, optionIndex) => {
+                  const selected = answers[question.id] === optionIndex;
+                  return (
+                    <label
+                      key={option}
+                      className={`flex cursor-pointer items-start gap-3 rounded-xl border p-3 text-sm transition-brand ${
+                        selected
+                          ? "border-brand-300 bg-brand-50/70 text-ink"
+                          : "border-line text-ink-soft hover:border-brand-200 hover:bg-paper"
+                      }`}
+                    >
+                      <input
+                        type="radio"
+                        name={question.id}
+                        checked={selected}
+                        onChange={() => choose(question.id, optionIndex)}
+                        className="sr-only"
+                      />
+                      {selected ? (
+                        <CheckCircle
+                          weight="fill"
+                          className="mt-0.5 size-4.5 shrink-0 text-brand-600"
+                        />
+                      ) : (
+                        <Circle className="mt-0.5 size-4.5 shrink-0 text-ink-faint" />
+                      )}
+                      <span>{option}</span>
+                    </label>
+                  );
+                })}
+              </div>
+            </fieldset>
+          </Card>
+        ))}
+      </div>
+
+      <div className="mt-6 flex flex-wrap items-center gap-4">
+        <Button size="lg" disabled={!complete} onClick={() => setSubmitted(true)}>
+          Show me where we are <ArrowRight weight="bold" className="size-4" />
+        </Button>
+        {!complete && (
+          <p className="text-sm text-ink-muted">
+            Answer all {QUESTIONS.length} to get a straight answer.
+          </p>
+        )}
+      </div>
+    </div>
+  );
+}
+
+function Result({ answers, onReset }: { answers: Answers; onReset: () => void }) {
+  const result = classifyReadiness(answers);
+  const content = TIER_CONTENT[result.tier];
+  const currentIndex = TIER_ORDER.indexOf(result.tier);
+
+  return (
+    <div className="scroll-mt-24">
+      {/* The ladder, so a church sees its tier as a position rather than a
+          verdict — the tiers above it are where it's going next. */}
+      <ol className="mb-8 grid gap-2 sm:grid-cols-4">
+        {TIER_ORDER.map((tier, index) => {
+          const isCurrent = index === currentIndex;
+          const isPast = index < currentIndex;
+          return (
+            <li
+              key={tier}
+              aria-current={isCurrent ? "step" : undefined}
+              className={`rounded-xl border p-3 text-xs font-semibold transition-brand ${
+                isCurrent
+                  ? "border-brand-400 bg-brand-600 text-white shadow-brand-glow"
+                  : isPast
+                    ? "border-brand-200 bg-brand-50 text-brand-700"
+                    : "border-line bg-surface text-ink-faint"
+              }`}
+            >
+              <span className="flex items-center gap-1.5">
+                {isPast ? (
+                  <CheckCircle weight="fill" className="size-3.5" />
+                ) : (
+                  <Path weight="bold" className="size-3.5" />
+                )}
+                Tier {index + 1}
+              </span>
+              <span className="mt-1 block leading-snug">{TIER_CONTENT[tier].label}</span>
+            </li>
+          );
+        })}
+      </ol>
+
+      <Card className="border-l-4 border-l-brand-500">
+        <Badge tone="brand" icon={Path}>
+          Tier {currentIndex + 1} of {TIER_ORDER.length}
+        </Badge>
+        <h2 className="mt-3 text-2xl font-extrabold text-ink sm:text-3xl">{content.label}</h2>
+        <p className="mt-2 text-lg text-ink-soft">{content.summary}</p>
+        <p className="mt-4 text-sm leading-relaxed text-ink-muted">{content.diagnosis}</p>
+
+        <div className="mt-6 grid gap-2 sm:grid-cols-4">
+          {Object.entries(DIMENSION_LABELS).map(([dimension, label]) => {
+            const cleared = result.cleared[dimension as keyof typeof result.cleared];
+            const isBlocker = result.blockedOn === dimension;
+            return (
+              <div
+                key={dimension}
+                className={`rounded-xl border p-3 ${
+                  isBlocker ? "border-accent-300 bg-accent-50" : "border-line bg-paper"
+                }`}
+              >
+                <p className="flex items-center gap-1.5 text-xs font-semibold text-ink-soft">
+                  {cleared ? (
+                    <CheckCircle weight="fill" className="size-3.5 text-success" />
+                  ) : (
+                    <Circle className="size-3.5 text-ink-faint" />
+                  )}
+                  {label}
+                </p>
+                <p className="mt-1 text-xs text-ink-muted">
+                  {isBlocker ? "This is what's next" : cleared ? "In place" : "Not yet"}
+                </p>
+              </div>
+            );
+          })}
+        </div>
+      </Card>
+
+      <Card className="mt-4">
+        <h3 className="text-base font-bold text-ink">Your next three moves</h3>
+        <ol className="mt-4 space-y-3">
+          {content.steps.map((step, index) => (
+            <li key={step} className="flex gap-3 text-sm text-ink-soft">
+              <span className="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent-100 text-xs font-extrabold text-accent-800">
+                {index + 1}
+              </span>
+              <span className="leading-relaxed">{step}</span>
+            </li>
+          ))}
+        </ol>
+      </Card>
+
+      <Card className="mt-4 border-l-4 border-l-accent-500">
+        <h3 className="flex items-center gap-2 text-base font-bold text-ink">
+          <Lightbulb weight="fill" className="size-4.5 text-accent-600" />
+          About your leadership
+        </h3>
+        <p className="mt-2 text-sm leading-relaxed text-ink-soft">{leadershipNote(result.scores)}</p>
+      </Card>
+
+      <Card
+        className={`mt-4 ${content.graduatesToChurchedIn ? "border-l-4 border-l-brand-600" : ""}`}
+      >
+        <h3 className="flex items-center gap-2 text-base font-bold text-ink">
+          {content.graduatesToChurchedIn ? (
+            <SealCheck weight="fill" className="size-4.5 text-brand-600" />
+          ) : (
+            <Compass weight="fill" className="size-4.5 text-ink-muted" />
+          )}
+          {content.graduatesToChurchedIn
+            ? "You're ready for ChurchedIn"
+            : "Where ChurchedIn fits for you"}
+        </h3>
+        <p className="mt-2 text-sm leading-relaxed text-ink-soft">{content.churchedIn}</p>
+        <div className="mt-5 flex flex-wrap items-center gap-3">
+          <LinkButton href={content.cta.href}>
+            {content.cta.label} <ArrowRight weight="bold" className="size-4" />
+          </LinkButton>
+          {content.secondaryCta && (
+            <LinkButton href={content.secondaryCta.href} variant="secondary">
+              {content.secondaryCta.label}
+            </LinkButton>
+          )}
+        </div>
+      </Card>
+
+      <div className="mt-6 flex flex-wrap items-center gap-4">
+        <Button variant="secondary" onClick={onReset}>
+          <ArrowClockwise weight="bold" className="size-4" /> Start over
+        </Button>
+        <p className="text-sm text-ink-muted">
+          Nothing you answered was saved.{" "}
+          <Link href="/discover" className="font-semibold text-brand-600 hover:underline">
+            Browse churches near you
+          </Link>
+          .
+        </p>
+      </div>
+    </div>
+  );
+}
