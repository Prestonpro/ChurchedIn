@@ -0,0 +1,168 @@
+import { describe, it, expect } from "vitest";
+import {
+  QUESTIONS,
+  DIMENSIONS,
+  READINESS_TIERS,
+  TIER_CONTENT,
+  TIER_ORDER,
+  LEADERSHIP_NOTES,
+  classifyReadiness,
+  dimensionScores,
+  isComplete,
+  leadershipNote,
+  type Answers,
+  type Dimension,
+} from "@/lib/readiness";
+
+/** Answers every question in a dimension with `value`, everything else with `fill`. */
+function answersWith(overrides: Partial<Record<Dimension, number>>, fill = 0): Answers {
+  const answers: Answers = {};
+  for (const q of QUESTIONS) {
+    answers[q.id] = overrides[q.dimension] ?? fill;
+  }
+  return answers;
+}
+
+const ALL_STRONG = answersWith({}, 2);
+
+describe("classifyReadiness", () => {
+  it("places a church with no awareness at the first tier, however keen it is otherwise", () => {
+    // The point of gating rather than averaging: an eager congregation that
+    // has never met an international student is still newly aware.
+    const result = classifyReadiness(answersWith({ AWARENESS: 0 }, 2));
+    expect(result.tier).toBe(READINESS_TIERS.NEWLY_AWARE);
+    expect(result.blockedOn).toBe(DIMENSIONS.AWARENESS);
+  });
+
+  it("places an aware church with no hosts at the willing-but-unready tier", () => {
+    const result = classifyReadiness(answersWith({ CONGREGATION: 0 }, 2));
+    expect(result.tier).toBe(READINESS_TIERS.WILLING_UNREADY);
+    expect(result.blockedOn).toBe(DIMENSIONS.CONGREGATION);
+  });
+
+  it("places an aware church with hosts but no plan at the ready-but-directionless tier", () => {
+    const result = classifyReadiness(answersWith({ DIRECTION: 0 }, 2));
+    expect(result.tier).toBe(READINESS_TIERS.READY_DIRECTIONLESS);
+    expect(result.blockedOn).toBe(DIMENSIONS.DIRECTION);
+  });
+
+  it("graduates a church that clears every gate", () => {
+    const result = classifyReadiness(ALL_STRONG);
+    expect(result.tier).toBe(READINESS_TIERS.ACTIVE);
+    expect(result.blockedOn).toBeNull();
+  });
+
+  it("reports the earliest gate when several are unmet", () => {
+    const result = classifyReadiness(answersWith({}, 0));
+    expect(result.tier).toBe(READINESS_TIERS.NEWLY_AWARE);
+    expect(result.blockedOn).toBe(DIMENSIONS.AWARENESS);
+  });
+
+  it("does not let weak leadership hold a church back", () => {
+    // "You don't have to be a pastor" — leadership shapes the advice but
+    // never the tier, so a grassroots church still graduates.
+    const result = classifyReadiness(answersWith({ LEADERSHIP: 0 }, 2));
+    expect(result.tier).toBe(READINESS_TIERS.ACTIVE);
+    expect(result.cleared.LEADERSHIP).toBe(false);
+  });
+
+  it("clears a two-question dimension at 3 of 4 but not at 2 of 4", () => {
+    const strongAndMiddling: Answers = { ...ALL_STRONG, "met-a-student": 1 };
+    expect(classifyReadiness(strongAndMiddling).cleared.AWARENESS).toBe(true);
+
+    const twoMiddling: Answers = { ...ALL_STRONG, "met-a-student": 1, "students-nearby": 1 };
+    expect(classifyReadiness(twoMiddling).cleared.AWARENESS).toBe(false);
+  });
+
+  it("requires the strongest answer to clear a single-question dimension", () => {
+    expect(classifyReadiness({ ...ALL_STRONG, "next-step": 1 }).cleared.DIRECTION).toBe(false);
+    expect(classifyReadiness({ ...ALL_STRONG, "next-step": 2 }).cleared.DIRECTION).toBe(true);
+  });
+
+  it("treats missing, out-of-range, and non-integer answers as unanswered", () => {
+    const scores = dimensionScores({
+      ...ALL_STRONG,
+      "students-nearby": 99,
+      "met-a-student": -1,
+      "next-step": 1.5,
+    });
+    expect(scores.AWARENESS).toBe(0);
+    expect(scores.DIRECTION).toBe(0);
+    expect(dimensionScores({}).AWARENESS).toBe(0);
+  });
+});
+
+describe("dimensionScores", () => {
+  it("normalizes every dimension to 0–1 regardless of question count", () => {
+    const scores = dimensionScores(ALL_STRONG);
+    for (const dimension of Object.values(DIMENSIONS)) {
+      expect(scores[dimension]).toBe(1);
+    }
+    expect(dimensionScores(answersWith({}, 1)).AWARENESS).toBe(0.5);
+  });
+});
+
+describe("isComplete", () => {
+  it("is false until every question is answered", () => {
+    expect(isComplete({})).toBe(false);
+    const allButOne = { ...ALL_STRONG };
+    delete allButOne[QUESTIONS[0].id];
+    expect(isComplete(allButOne)).toBe(false);
+  });
+
+  it("accepts a zero answer — 'we only just realized' is an answer", () => {
+    expect(isComplete(answersWith({}, 0))).toBe(true);
+  });
+
+  it("rejects an out-of-range option index", () => {
+    expect(isComplete({ ...ALL_STRONG, [QUESTIONS[0].id]: 3 })).toBe(false);
+  });
+});
+
+describe("leadershipNote", () => {
+  it("matches the note to where leadership actually stands", () => {
+    expect(leadershipNote(dimensionScores(ALL_STRONG))).toBe(LEADERSHIP_NOTES.strong);
+    expect(leadershipNote(dimensionScores(answersWith({ LEADERSHIP: 1 }, 2)))).toBe(
+      LEADERSHIP_NOTES.partial,
+    );
+    expect(leadershipNote(dimensionScores(answersWith({ LEADERSHIP: 0 }, 2)))).toBe(
+      LEADERSHIP_NOTES.absent,
+    );
+  });
+});
+
+describe("tier content", () => {
+  it("covers every tier, in ladder order, with three steps each", () => {
+    expect(TIER_ORDER).toHaveLength(Object.keys(READINESS_TIERS).length);
+    for (const tier of TIER_ORDER) {
+      const content = TIER_CONTENT[tier];
+      expect(content).toBeDefined();
+      expect(content.steps).toHaveLength(3);
+    }
+  });
+
+  it("only sends the two ready tiers into ChurchedIn", () => {
+    // The synthesis is explicit that ChurchedIn is the graduation
+    // destination, not the answer for a church at tier one.
+    expect(TIER_CONTENT.NEWLY_AWARE.graduatesToChurchedIn).toBe(false);
+    expect(TIER_CONTENT.WILLING_UNREADY.graduatesToChurchedIn).toBe(false);
+    expect(TIER_CONTENT.READY_DIRECTIONLESS.graduatesToChurchedIn).toBe(true);
+    expect(TIER_CONTENT.ACTIVE.graduatesToChurchedIn).toBe(true);
+  });
+});
+
+describe("questions", () => {
+  it("has unique ids and three ordered options each", () => {
+    const ids = QUESTIONS.map((q) => q.id);
+    expect(new Set(ids).size).toBe(ids.length);
+    for (const q of QUESTIONS) {
+      expect(q.options).toHaveLength(3);
+    }
+  });
+
+  it("covers every dimension the classifier reads", () => {
+    for (const dimension of Object.values(DIMENSIONS)) {
+      expect(QUESTIONS.some((q) => q.dimension === dimension)).toBe(true);
+    }
+  });
+});
