+      { eventId: dinner.id, userId: users.ana.id, role: "ATTENDEE", status: "CONFIRMED", createdAt: hoursAgo(4 * 24) },
+      { eventId: dinner.id, userId: users.kenji.id, role: "ATTENDEE", status: "CONFIRMED", createdAt: hoursAgo(3 * 24) },
+      { eventId: dinner.id, userId: users.priya.id, role: "ATTENDEE", status: "CONFIRMED", createdAt: hoursAgo(2 * 24) },
+      // The fifth student — four seats, so this one waits.
+      { eventId: dinner.id, userId: users.mehdi.id, role: "ATTENDEE", status: "WAITLISTED", createdAt: hoursAgo(16) },
+    ],
+  });
+
+  // ---- Gathering 3: upcoming with room to spare, so a reviewer can RSVP
+  // themselves during a demo and get CONFIRMED rather than waitlisted.
+  const coffee = await prisma.event.create({
+    data: {
