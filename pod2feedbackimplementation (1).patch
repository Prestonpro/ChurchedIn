+            role: person.role,
+            createdAt: hoursAgo(person.joinedHoursAgo),
+          },
+        },
+        ...(person.mentor
+          ? {
+              mentorProfile: {
+                create: {
+                  languages: person.mentor.languages,
+                  interests: person.mentor.interests,
+                  openToMentor: person.mentor.openToMentor ?? true,
+                },
+              },
+            }
+          : {}),
+        ...(person.student ? { studentProfile: { create: person.student } } : {}),
+      },
+    });
+    users[person.key] = { id: user.id, name: user.name };
+  }
+
