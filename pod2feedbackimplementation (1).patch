new file mode 100644
index 0000000..7527140
--- /dev/null
+++ b/src/lib/churchActivity.ts
@@ -0,0 +1,187 @@
+import { ROLES, RSVP_ROLE, type Role, type RsvpRole } from "@/lib/constants";
+
+/**
+ * Builds the "what's been happening here" feed shown on /stories.
+ *
+ * The Demo Day note this answers (Thanh's, on volunteer supply) is that a
+ * hesitant volunteer needs evidence other people are already doing this. A
+ * church space that looks quiet reads as abandoned even when it isn't, so
+ * this derives visible momentum from activity the church can already see —
+ * gatherings planned, people joining, RSVPs, stories shared — rather than
+ * adding a table to track it.
+ *
+ * Two things are deliberately NOT sources here: mentor connections and ride
+ * requests. Both are one-to-one relationships whose existence is private
+ * between the two people in them (and gated behind an accept step), so
+ * broadcasting "Ana connected with David" to the whole church would leak
+ * exactly what connectionState.ts and rideState.ts exist to protect.
+ *
+ * Pure and Prisma-free so the merge/sort/cap rules are unit-testable — the
+ * queries that feed it live in queries.ts (listChurchActivity).
+ */
+
+export const ACTIVITY_KINDS = {
+  EVENT_CREATED: "EVENT_CREATED",
+  MEMBER_JOINED: "MEMBER_JOINED",
+  RSVP: "RSVP",
+  STORY_SHARED: "STORY_SHARED",
+} as const;
+
+export type ActivityKind = (typeof ACTIVITY_KINDS)[keyof typeof ACTIVITY_KINDS];
+
+export type ActivityItem = {
+  /** Prefixed with the kind so ids stay unique once four tables are merged. */
+  id: string;
+  kind: ActivityKind;
+  at: Date;
+  /** First name only — the feed is a nudge, not a roster. */
+  actor: string;
+  /** The sentence after the name, e.g. "planned Welcome dinner". */
+  summary: string;
+  /** Where to go to see the thing itself, when there is somewhere to go. */
+  href?: string;
+};
+
+export type ActivitySources = {
+  events: {
+    id: string;
+    title: string;
+    createdAt: Date;
+    createdBy: { name: string };
+  }[];
+  members: {
+    id: string;
+    createdAt: Date;
+    role: string;
+    user: { name: string };
+  }[];
+  rsvps: {
+    id: string;
+    createdAt: Date;
+    role: string;
+    user: { name: string };
+    event: { id: string; title: string };
+  }[];
+  stories: {
+    id: string;
+    createdAt: Date;
+    author: { name: string };
+  }[];
+};
+
+/** The feed is first-names-only; a full roster already exists in church settings. */
+export function firstName(name: string): string {
+  return name.trim().split(/\s+/)[0] || name;
+}
+
+const ROLE_WORDS: Record<Role, string> = {
+  CHURCH_ADMIN: "a church leader",
+  VOLUNTEER: "a volunteer",
+  STUDENT: "a student",
+};
+
+function roleWord(role: string): string {
+  return ROLE_WORDS[role as Role] ?? ROLE_WORDS[ROLES.STUDENT];
+}
+
+const RSVP_VERBS: Record<RsvpRole, (title: string) => string> = {
+  HELPER: (title) => `signed up to help with ${title}`,
+  ATTENDEE: (title) => `is coming to ${title}`,
+};
+
+function rsvpSummary(role: string, title: string): string {
+  const verb = RSVP_VERBS[role as RsvpRole] ?? RSVP_VERBS[RSVP_ROLE.ATTENDEE];
+  return verb(title);
+}
+
+/**
+ * Merges every source into one newest-first feed, capped at `limit`.
+ *
+ * Callers over-fetch each source independently (there's no way to know which
+ * table holds the most recent rows without reading all four), so the cap has
+ * to be applied here, after the merge, or the feed would silently favor
+ * whichever source happened to be queried first.
+ */
+export function buildActivityFeed(sources: ActivitySources, limit = 12): ActivityItem[] {
+  const items: ActivityItem[] = [
+    ...sources.events.map((event) => ({
+      id: `event-${event.id}`,
+      kind: ACTIVITY_KINDS.EVENT_CREATED,
+      at: event.createdAt,
+      actor: firstName(event.createdBy.name),
+      summary: `planned ${event.title}`,
+      href: `/events/${event.id}`,
+    })),
+    ...sources.members.map((membership) => ({
+      id: `member-${membership.id}`,
+      kind: ACTIVITY_KINDS.MEMBER_JOINED,
+      at: membership.createdAt,
+      actor: firstName(membership.user.name),
+      summary: `joined as ${roleWord(membership.role)}`,
+    })),
+    ...sources.rsvps.map((rsvp) => ({
+      id: `rsvp-${rsvp.id}`,
+      kind: ACTIVITY_KINDS.RSVP,
+      at: rsvp.createdAt,
+      actor: firstName(rsvp.user.name),
+      summary: rsvpSummary(rsvp.role, rsvp.event.title),
+      href: `/events/${rsvp.event.id}`,
+    })),
+    ...sources.stories.map((story) => ({
+      id: `story-${story.id}`,
+      kind: ACTIVITY_KINDS.STORY_SHARED,
+      at: story.createdAt,
+      actor: firstName(story.author.name),
+      summary: "shared a story",
+      href: "/stories",
+    })),
+  ];
+
+  return items.sort((a, b) => b.at.getTime() - a.at.getTime()).slice(0, Math.max(0, limit));
+}
+
+/** An empty source set for callers with no active church (see /stories). */
+export const EMPTY_ACTIVITY_SOURCES: ActivitySources = {
+  events: [],
+  members: [],
+  rsvps: [],
+  stories: [],
+};
+
+const MINUTE = 60 * 1000;
+const HOUR = 60 * MINUTE;
+const DAY = 24 * HOUR;
+const WEEK = 7 * DAY;
+
+/**
+ * Coarse "3 days ago" phrasing for the activity feed. Deliberately coarse:
+ * this feed answers "is anything happening here", and a precise timestamp
+ * invites the reader to audit individual people's participation instead.
+ * `now` is a parameter rather than a `new Date()` call inside so it's
+ * testable without freezing the clock.
+ *
+ * Rendered only from Server Components, so there's no hydration concern
+ * about the server and client disagreeing on the current time.
+ */
+export function relativeTime(at: Date, now: Date = new Date()): string {
+  const elapsed = now.getTime() - at.getTime();
+  // A clock skew between the app server and Postgres can hand us a
+  // timestamp a few seconds in the future; "in 4 seconds" would be a
+  // strange thing to show, so anything not yet past reads as just now.
+  if (elapsed < MINUTE) return "just now";
+  if (elapsed < HOUR) {
+    const minutes = Math.floor(elapsed / MINUTE);
+    return `${minutes}m ago`;
+  }
+  if (elapsed < DAY) {
+    const hours = Math.floor(elapsed / HOUR);
+    return `${hours}h ago`;
+  }
+  if (elapsed < WEEK) {
+    const days = Math.floor(elapsed / DAY);
+    return days === 1 ? "yesterday" : `${days} days ago`;
+  }
+  const weeks = Math.floor(elapsed / WEEK);
+  if (weeks < 5) return weeks === 1 ? "last week" : `${weeks} weeks ago`;
+  return at.toLocaleDateString(undefined, { month: "short", day: "numeric" });
+}
