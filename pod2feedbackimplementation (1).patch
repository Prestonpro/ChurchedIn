+        "Bring nothing; there is always too much food.",
+      category: "DINNER",
+      startsAt: daysFromNow(-6, 17),
+      endsAt: daysFromNow(-6, 20),
+      location: "The Adeyemis' backyard, 410 Maple Street",
+      atChurch: false,
+      volunteerCap: 3,
+      studentCap: 12,
+      churchId: church.id,
+      createdById: users.naomi.id,
+      createdAt: hoursAgo(21 * 24),
+      cohosts: { create: { userId: users.david.id, createdAt: hoursAgo(20 * 24) } },
+    },
+  });
+
+  await prisma.eventRsvp.createMany({
+    data: [
+      { eventId: cookout.id, userId: users.grace.id, role: "HELPER", status: "CONFIRMED", createdAt: hoursAgo(19 * 24) },
+      { eventId: cookout.id, userId: users.sam.id, role: "HELPER", status: "CONFIRMED", createdAt: hoursAgo(18 * 24) },
+      { eventId: cookout.id, userId: users.wei.id, role: "ATTENDEE", status: "CONFIRMED", createdAt: hoursAgo(17 * 24) },
+      { eventId: cookout.id, userId: users.ana.id, role: "ATTENDEE", status: "CONFIRMED", createdAt: hoursAgo(13 * 24) },
+      { eventId: cookout.id, userId: users.kenji.id, role: "ATTENDEE", status: "CONFIRMED", createdAt: hoursAgo(8 * 24) },
+    ],
+  });
+
+  // ---- Gathering 2: upcoming and deliberately oversubscribed. This is the
+  // one that has to exist for a demo to land: a headcount of four with five
+  // students signed up, so the fifth is genuinely WAITLISTED and any
+  // confirmed attendee cancelling their own RSVP visibly promotes them (see
+  // cancelRsvpAction in src/lib/actions/rsvps.ts — promotion is scoped to the
+  // same role bucket, so a confirmed ATTENDEE has to be the one to drop).
+  // Statuses are written explicitly here rather than going through
+  // decideRsvpStatus, but they're what it would return for these caps, and
+  // the waitlisted row is the newest so pickPromotionCandidate's
+  // longest-waiting-first rule picks the person a demo expects.
+  const dinner = await prisma.event.create({
+    data: {
