+        time: "10:00 AM",
+        notes: "First big grocery run — I don't have a car yet.",
+        status: "CLAIMED",
+        type: "GENERAL",
+        churchId: church.id,
+        studentId: users.mehdi.id,
+        volunteerId: users.david.id,
+        createdAt: hoursAgo(19),
+      },
+    ],
+  });
+
+  // Volunteer stories — one shared beyond the church (so the church profile
+  // page has something in "From the people who host"), one kept internal.
+  await prisma.volunteerStory.createMany({
+    data: [
+      {
+        body:
+          "I put off hosting for two years because I was sure I'd run out of things to talk " +
+          "about. Four students came for dinner in February and they stayed until eleven. " +
+          "Wei asked if he could help cook next time. That was the whole thing — I didn't " +
