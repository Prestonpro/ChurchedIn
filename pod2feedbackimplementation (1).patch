+/**
+ * Seeds one demo church with enough life in it to actually demo.
+ *
+ * Demo Day's most practical note was the last one on the list: never demo
+ * from an empty database. An empty church space doesn't show a reviewer the
+ * waitlist promoting someone, the friend directory withholding an email, or
+ * a volunteer's story sitting under a gathering — it shows them a set of
+ * empty states. So this creates a church with ten people, three gatherings
+ * (one already happened, one deliberately over capacity so there's a real
+ * waitlist), connections in both accepted and pending states, a claimed and
+ * an open ride, and two volunteer stories.
+ *
+ *   npm run db:seed
+ *
+ * Safe to re-run: it resets the demo church's own rows and rebuilds them, so
+ * a demo always starts from the same known state. It will refuse to touch a
+ * church that isn't clearly this script's own — see assertIsDemoChurch.
+ *
+ * Everything created here uses @demo.churchedin.internal email addresses.
+ * That is deliberately NOT the @seed.churchedin.internal suffix used by the
+ * Bryan/College Station map listings: those are placeholder accounts for
+ * churches with no real members yet, and listDiscoverableChurches uses that
+ * suffix to grey them out on the map. The demo church is supposed to look
+ * alive, because looking alive is the entire point of it.
+ */
+import "dotenv/config";
+import bcrypt from "bcryptjs";
+import { PrismaPg } from "@prisma/adapter-pg";
+import { PrismaClient } from "../src/generated/prisma/client";
+
+const DEMO_JOIN_CODE = "DEMO24";
+const DEMO_EMAIL_DOMAIN = "demo.churchedin.internal";
+/** Every demo account shares this password so a demo can log in as anyone. */
+const DEMO_PASSWORD = "demo-password-1234";
+
+const connectionString = process.env.DATABASE_URL;
+if (!connectionString) {
+  console.error("DATABASE_URL is not set. Copy .env.example to .env first.");
+  process.exit(1);
+}
+const schema = new URL(connectionString).searchParams.get("schema") ?? undefined;
+const prisma = new PrismaClient({
+  adapter: new PrismaPg(connectionString, schema ? { schema } : undefined),
+});
+
+const HOUR = 60 * 60 * 1000;
+const DAY = 24 * HOUR;
+
+/** Relative to run time, so a freshly seeded demo always has a "next week". */
+function daysFromNow(days: number, hour = 18): Date {
+  const date = new Date(Date.now() + days * DAY);
+  date.setHours(hour, 0, 0, 0);
+  return date;
+}
+
+function hoursAgo(hours: number): Date {
+  return new Date(Date.now() - hours * HOUR);
+}
+
+type PersonSpec = {
+  key: string;
+  name: string;
+  role: "CHURCH_ADMIN" | "VOLUNTEER" | "STUDENT";
+  bio: string;
+  /** Volunteers/admins get a MentorProfile; students get a StudentProfile. */
+  mentor?: { languages: string; interests: string; openToMentor?: boolean };
+  student?: { countryOfOrigin: string; school: string; languages: string; interests: string };
+  /** How long ago they joined, so the activity feed has a plausible history. */
+  joinedHoursAgo: number;
+};
+
+const PEOPLE: PersonSpec[] = [
+  {
+    key: "naomi",
+    name: "Naomi Adeyemi",
+    role: "CHURCH_ADMIN",
+    bio: "Leads hospitality at Maple Street. Cooks too much food on purpose.",
+    mentor: { languages: "English, Yoruba", interests: "Cooking, gardening, long dinners" },
+    joinedHoursAgo: 70 * 24,
+  },
+  {
+    key: "david",
+    name: "David Okonkwo",
+    role: "VOLUNTEER",
+    bio: "Drives the airport runs. Will talk about football with anyone.",
+    mentor: { languages: "English, Igbo", interests: "Football, cycling, board games" },
+    joinedHoursAgo: 62 * 24,
+  },
+  {
+    key: "grace",
+    name: "Grace Lin",
+    role: "VOLUNTEER",
+    bio: "Grad student turned volunteer — was on the other side of this six years ago.",
+    mentor: { languages: "English, Mandarin", interests: "Hiking, photography, dumplings" },
+    joinedHoursAgo: 40 * 24,
+  },
+  {
+    key: "sam",
+    name: "Sam Ortiz",
+    role: "VOLUNTEER",
+    bio: "Hosts the coffee chats. Believes strongly in a second cup.",
+    mentor: { languages: "English, Spanish", interests: "Coffee, guitar, cycling" },
+    joinedHoursAgo: 26 * 24,
+  },
+  {
+    key: "ruth",
