index 0000000..836b8ce
--- /dev/null
+++ b/src/lib/readiness.ts
@@ -0,0 +1,314 @@
+/**
+ * The Readiness Pathway — the tiered self-assessment behind /readiness.
+ *
+ * This exists to answer the sharpest piece of Demo Day feedback we got
+ * (Aaron's): "church" is not a persona. Which church are we serving — one
+ * that's newly aware international students are nearby, one whose pastor is
+ * willing but whose congregation isn't, or one that's ready but has no idea
+ * what to actually do? The three tiers below ARE those three church types,
+ * kept in his words on purpose so the segmentation stays legible to
+ * everyone who gave us that note. A fourth state (ACTIVE) is the graduation
+ * case: a church that clears every dimension doesn't need a pathway, it
+ * needs the product, so that tier routes straight into ChurchedIn.
+ *
+ * Deliberately pure and dependency-free: no Prisma, no session, no React.
+ * The assessment is anonymous — a church shouldn't have to make an account
+ * to find out it isn't ready for one yet — so nothing here is persisted and
+ * the whole thing can be unit-tested (see readiness.test.ts) and run
+ * client-side.
+ */
+
+export const READINESS_TIERS = {
+  NEWLY_AWARE: "NEWLY_AWARE",
+  WILLING_UNREADY: "WILLING_UNREADY",
+  READY_DIRECTIONLESS: "READY_DIRECTIONLESS",
+  ACTIVE: "ACTIVE",
+} as const;
+
+export type ReadinessTier = (typeof READINESS_TIERS)[keyof typeof READINESS_TIERS];
+
+/** Tiers low-to-high, for the ladder display on /readiness. */
+export const TIER_ORDER: ReadinessTier[] = [
+  READINESS_TIERS.NEWLY_AWARE,
+  READINESS_TIERS.WILLING_UNREADY,
+  READINESS_TIERS.READY_DIRECTIONLESS,
+  READINESS_TIERS.ACTIVE,
+];
+
+/**
+ * The four things we're actually measuring. AWARENESS, CONGREGATION and
+ * DIRECTION are the gates — in that order — because that's the order they
+ * actually block a church: you can't mobilize people who don't know the
+ * students exist, you can't run a gathering without hosts, and hosts with
+ * no plan stall out. LEADERSHIP is deliberately NOT a gate: this app's
+ * whole "you don't have to be a pastor" stance means a grassroots pair of
+ * households shouldn't be told they're unready because they never asked
+ * permission. It shapes the advice instead (see LEADERSHIP_NOTES).
+ */
+export const DIMENSIONS = {
+  AWARENESS: "AWARENESS",
+  LEADERSHIP: "LEADERSHIP",
+  CONGREGATION: "CONGREGATION",
+  DIRECTION: "DIRECTION",
+} as const;
+
+export type Dimension = (typeof DIMENSIONS)[keyof typeof DIMENSIONS];
+
+export type ReadinessQuestion = {
+  id: string;
+  dimension: Dimension;
+  prompt: string;
+  /** Ordered weakest-to-strongest; the index is the answer's score (0, 1, 2). */
+  options: string[];
+};
+
+export const QUESTIONS: ReadinessQuestion[] = [
+  {
+    id: "students-nearby",
+    dimension: DIMENSIONS.AWARENESS,
+    prompt: "How well does your church know the international students near you?",
+    options: [
+      "We only just realized there are any nearby.",
+      "A few of us have noticed them, but we've never really looked.",
+      "We know roughly how many there are and where they study.",
+    ],
+  },
+  {
+    id: "met-a-student",
+    dimension: DIMENSIONS.AWARENESS,
+    prompt: "Has anyone from your church actually met one of them in the past year?",
+    options: [
+      "Not that I know of.",
+      "One or two people have, in passing.",
+      "Several of us have students we'd recognize by name.",
+    ],
+  },
+  {
+    id: "leadership",
+    dimension: DIMENSIONS.LEADERSHIP,
+    prompt: "Where does your pastor or leadership team stand on this?",
+    options: [
+      "Nobody has asked them yet.",
+      "Supportive in principle, but it isn't a priority.",
+      "They'd put it in front of the congregation and back it publicly.",
+    ],
+  },
+  {
+    id: "who-would-host",
+    dimension: DIMENSIONS.CONGREGATION,
+    prompt: "If a dinner for eight students were on the calendar next month, who would host it?",
+    options: [
+      "I honestly don't know who I'd ask.",
+      "I could probably talk one household into it.",
+      "Two or three households would say yes without much persuading.",
+    ],
+  },
+  {
+    id: "congregation-reaction",
+    dimension: DIMENSIONS.CONGREGATION,
+    prompt: "How does your congregation react when this comes up?",
+    options: [
+      "It hasn't come up.",
+      "Warm in theory — but nobody has signed up for anything.",
+      "People ask how they can help.",
+    ],
+  },
+  {
+    id: "next-step",
+    dimension: DIMENSIONS.DIRECTION,
+    prompt: "What's your next concrete step?",
+    options: [
+      "That's exactly the part we don't know.",
+      "We have ideas, but nothing on the calendar.",
+      "There's a date, a host, and someone inviting students.",
+    ],
+  },
+];
+
+/** questionId -> chosen option index. Missing entries score 0. */
+export type Answers = Record<string, number>;
+
+/**
+ * A dimension counts as cleared at 75% of its available points. With the
+ * 0/1/2 options above that means a two-question dimension needs 3 of 4
+ * (so: one strong answer and one middling one, but not two middling ones),
+ * and the single-question dimensions need the strongest answer outright.
+ * Strict on purpose — the failure mode we're guarding against is a church
+ * telling itself it's ready, showing up to a launch, and stalling.
+ */
+export const CLEAR_THRESHOLD = 0.75;
+
+const MAX_SCORE_PER_QUESTION = 2;
+
+/** 0–1 score per dimension, so dimensions with different question counts stay comparable. */
+export function dimensionScores(answers: Answers): Record<Dimension, number> {
+  const scores = {} as Record<Dimension, number>;
+  for (const dimension of Object.values(DIMENSIONS)) {
+    const questions = QUESTIONS.filter((q) => q.dimension === dimension);
+    const earned = questions.reduce((sum, q) => sum + clampAnswer(q, answers[q.id]), 0);
+    scores[dimension] = earned / (questions.length * MAX_SCORE_PER_QUESTION);
+  }
+  return scores;
+}
+
+/** Guards against an out-of-range or missing option index reaching the score math. */
+function clampAnswer(question: ReadinessQuestion, value: number | undefined): number {
+  if (typeof value !== "number" || !Number.isInteger(value)) return 0;
+  if (value < 0 || value >= question.options.length) return 0;
+  return value;
+}
+
+export type ReadinessResult = {
+  tier: ReadinessTier;
+  scores: Record<Dimension, number>;
+  cleared: Record<Dimension, boolean>;
+  /** The gate that stopped them, or null once every gate is cleared. */
+  blockedOn: Dimension | null;
+};
+
+/**
+ * Places a church on the pathway. The tier is the FIRST uncleared gate, not
+ * an average — a church with a wildly enthusiastic congregation that has
+ * never met an international student is still newly aware, and averaging
+ * would hide that behind a middling overall score.
+ */
+export function classifyReadiness(answers: Answers): ReadinessResult {
+  const scores = dimensionScores(answers);
+  const cleared = {} as Record<Dimension, boolean>;
+  for (const dimension of Object.values(DIMENSIONS)) {
+    cleared[dimension] = scores[dimension] >= CLEAR_THRESHOLD;
+  }
+
+  const gates: { dimension: Dimension; tier: ReadinessTier }[] = [
+    { dimension: DIMENSIONS.AWARENESS, tier: READINESS_TIERS.NEWLY_AWARE },
+    { dimension: DIMENSIONS.CONGREGATION, tier: READINESS_TIERS.WILLING_UNREADY },
+    { dimension: DIMENSIONS.DIRECTION, tier: READINESS_TIERS.READY_DIRECTIONLESS },
+  ];
+  const blocking = gates.find((gate) => !cleared[gate.dimension]);
+
+  return {
+    tier: blocking ? blocking.tier : READINESS_TIERS.ACTIVE,
+    scores,
+    cleared,
+    blockedOn: blocking?.dimension ?? null,
+  };
+}
+
+/** True once every question has a valid answer — the result is meaningless before that. */
+export function isComplete(answers: Answers): boolean {
+  return QUESTIONS.every((q) => {
+    const value = answers[q.id];
+    return typeof value === "number" && value >= 0 && value < q.options.length;
+  });
+}
+
+export type TierContent = {
+  /** Aaron's name for this church type, kept close to his wording. */
+  label: string;
+  /** The one-line "this is you" read. */
+  summary: string;
+  /** Why this tier is where the church actually is. */
+  diagnosis: string;
+  /** Three concrete moves, in order — not a checklist of everything possible. */
+  steps: string[];
+  /** What ChurchedIn does for a church at THIS tier — honestly, including "not much yet". */
+  churchedIn: string;
+  cta: { label: string; href: string };
+  secondaryCta?: { label: string; href: string };
+  /** True for the tiers where ChurchedIn itself is the right next move. */
+  graduatesToChurchedIn: boolean;
+};
+
+export const TIER_CONTENT: Record<ReadinessTier, TierContent> = {
+  NEWLY_AWARE: {
+    label: "Newly aware",
+    summary: "You've just learned international students are your neighbors.",
+    diagnosis:
+      "Nothing here is a capacity problem yet — it's a proximity problem. Before you can mobilize anyone, a handful of people at your church need to have met an actual student, not an idea of one.",
+    steps: [
