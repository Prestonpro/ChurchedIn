+      {
+        body:
+          "Practical note for whoever hosts the next cookout: we badly underestimated rides. " +
+          "Three students said yes and then couldn't get across town, and I only found out " +
+          "the morning of. Ask about transport when you ask about dietary restrictions, not " +
+          "the day before.",
+        sharePublicly: false,
+        churchId: church.id,
+        authorId: users.sam.id,
+        createdAt: hoursAgo(5 * 24),
+      },
+    ],
+  });
+
+  const counts = {
+    people: PEOPLE.length,
+    gatherings: 3,
+    rsvps: await prisma.eventRsvp.count({ where: { event: { churchId: church.id } } }),
+    waitlisted: await prisma.eventRsvp.count({
+      where: { event: { churchId: church.id }, status: "WAITLISTED" },
+    }),
+  };
+
+  console.log(`
+Seeded "${church.name}".
+
+  Join code:  ${DEMO_JOIN_CODE}
+  People:     ${counts.people} (1 leader, 4 volunteers, 5 students)
+  Gatherings: ${counts.gatherings} — 1 past, 1 full with a waitlist, 1 with room
+  RSVPs:      ${counts.rsvps} (${counts.waitlisted} waitlisted)
+
+  Log in as any of these with the password ${DEMO_PASSWORD}:
+${PEOPLE.map((p) => `    ${p.key}@${DEMO_EMAIL_DOMAIN}  (${p.role.toLowerCase()}, ${p.name})`).join("\n")}
+
+  Try: log in as wei, open "Dinner at the Adeyemis'", and cancel his RSVP —
+  Mehdi is promoted off the waitlist (only the person who RSVP'd can cancel
+  it, so this has to be a confirmed student, not the host).
+`);
+}
+
+main()
+  .then(() => prisma.$disconnect())
+  .catch(async (error) => {
+    console.error(error);
+    await prisma.$disconnect();
+    process.exit(1);
+  });
