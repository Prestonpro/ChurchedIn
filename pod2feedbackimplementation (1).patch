index 0000000..d243985
--- /dev/null
+++ b/src/app/stories/StoryActions.tsx
@@ -0,0 +1,88 @@
+"use client";
+
+import { useState, useTransition } from "react";
+import { Eye, EyeSlash, Trash } from "@phosphor-icons/react/dist/ssr";
+import { Button } from "@/components/ui/Button";
+import { FormError } from "@/components/ui/Field";
+import {
+  deleteVolunteerStoryAction,
+  toggleStoryVisibilityAction,
+  type ActionResult,
+} from "@/lib/actions/stories";
+
+/**
+ * Per-story controls. `canToggle` (author only) and `canDelete` (author or a
+ * church admin) are decided on the server and passed in — these are just the
+ * buttons; both actions re-check permission themselves.
+ */
+export function StoryActions({
+  storyId,
+  sharePublicly,
+  canToggle,
+  canDelete,
+}: {
+  storyId: string;
+  sharePublicly: boolean;
+  canToggle: boolean;
+  canDelete: boolean;
+}) {
+  const [pending, startTransition] = useTransition();
+  const [error, setError] = useState<string | undefined>(undefined);
+
+  function run(action: (id: string) => Promise<ActionResult>, confirmMessage?: string) {
+    if (confirmMessage && !confirm(confirmMessage)) return;
+    setError(undefined);
+    startTransition(async () => {
+      const result = await action(storyId);
+      if (result && "error" in result) {
+        setError(result.error);
+      }
+    });
+  }
+
+  if (!canToggle && !canDelete) return null;
+
+  return (
+    <div className="space-y-1.5">
+      <FormError message={error} />
+      <div className="flex items-center gap-2">
+        {canToggle && (
+          <Button
+            variant="ghost"
+            size="sm"
+            disabled={pending}
+            onClick={() => run(toggleStoryVisibilityAction)}
+            title={
+              sharePublicly
+                ? "Stop showing this on the church's public page"
+                : "Show this on the church's public page"
+            }
+          >
+            {sharePublicly ? (
+              <>
+                <EyeSlash weight="bold" className="size-3.5" /> Make private
+              </>
+            ) : (
+              <>
+                <Eye weight="bold" className="size-3.5" /> Share publicly
+              </>
+            )}
+          </Button>
+        )}
+        {canDelete && (
+          <Button
+            variant="ghost"
+            size="sm"
+            disabled={pending}
+            onClick={() =>
+              run(deleteVolunteerStoryAction, "Remove this story? This can't be undone.")
+            }
+            title="Remove this story"
+          >
+            <Trash weight="bold" className="size-3.5" /> Remove
+          </Button>
+        )}
+      </div>
+    </div>
+  );
+}
