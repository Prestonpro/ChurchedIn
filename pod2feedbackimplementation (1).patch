--- /dev/null
+++ b/src/app/stories/StoryForm.tsx
@@ -0,0 +1,43 @@
+"use client";
+
+import { useActionState, useState } from "react";
+import { createVolunteerStoryAction } from "@/lib/actions/stories";
+import { TextAreaField, CheckboxField, FormError } from "@/components/ui/Field";
+import { SubmitButton } from "@/components/ui/SubmitButton";
+
+/** Remounted via `key` after a successful submit to clear the textarea — the
+ * new story appearing in the list below is the confirmation, so there's no
+ * separate banner to go stale (same pattern as RideRequestForm). */
+export function StoryForm() {
+  const [state, formAction] = useActionState(createVolunteerStoryAction, undefined);
+  const [formKey, setFormKey] = useState(0);
+  const [lastState, setLastState] = useState(state);
+
+  if (state !== lastState) {
+    setLastState(state);
+    if (state && "ok" in state && state.ok) {
+      setFormKey((k) => k + 1);
+    }
+  }
+
+  return (
+    <form key={formKey} action={formAction} className="space-y-4">
+      <FormError message={state && "error" in state ? state.error : undefined} />
+      <TextAreaField
+        label="What happened?"
+        name="body"
+        required
+        minLength={60}
+        maxLength={1500}
+        className="min-h-32"
+        hint="Concrete beats inspiring. What you cooked, what you were nervous about, what you'd tell someone considering it."
+        placeholder="We had four students over for dinner and I spent the whole afternoon worrying nobody would talk. They stayed until eleven…"
+      />
+      <CheckboxField
+        label="Also show this on our church's public page (first name only)"
+        name="sharePublicly"
+      />
+      <SubmitButton pendingText="Sharing…">Share this story</SubmitButton>
+    </form>
+  );
+}
