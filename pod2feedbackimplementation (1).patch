index 0000000..adf67f5
--- /dev/null
+++ b/src/app/stories/page.tsx
@@ -0,0 +1,187 @@
+import Link from "next/link";
+import { redirect } from "next/navigation";
+import type { Metadata } from "next";
+import {
+  CalendarPlus,
+  ChatCenteredText,
+  Globe,
+  HandHeart,
+  Quotes,
+  UserPlus,
+  Users,
+} from "@phosphor-icons/react/dist/ssr";
+import { requireUser } from "@/lib/auth";
+import { listVolunteerStoriesForChurch, listChurchActivity } from "@/lib/queries";
+import { AuthShell } from "@/components/nav/AuthShell";
+import { Card } from "@/components/ui/Card";
+import { Badge } from "@/components/ui/Badge";
+import { Avatar } from "@/components/ui/Avatar";
+import { EmptyState } from "@/components/ui/EmptyState";
+import { ROLES } from "@/lib/constants";
+import { ACTIVITY_KINDS, relativeTime, type ActivityKind } from "@/lib/churchActivity";
+import { StoryForm } from "./StoryForm";
+import { StoryActions } from "./StoryActions";
+
+export const metadata: Metadata = {
+  title: "Stories",
+};
+
+const ACTIVITY_ICONS: Record<ActivityKind, typeof CalendarPlus> = {
+  EVENT_CREATED: CalendarPlus,
+  MEMBER_JOINED: UserPlus,
+  RSVP: HandHeart,
+  STORY_SHARED: ChatCenteredText,
+};
+
+/**
+ * Volunteer stories + the church's activity feed — the answer to Demo Day's
+ * volunteer-supply note (Thanh's): the people best placed to recruit a
+ * hesitant congregation are the volunteers who already said yes, so give
+ * them somewhere to say what it was actually like, and give the church
+ * visible evidence that things are happening here.
+ *
+ * Open to every member, not just volunteers: a student reading why a host
+ * was nervous the first time is the point. Writing is limited to volunteers
+ * and leaders (see the VolunteerStory doc comment in schema.prisma).
+ */
+export default async function StoriesPage() {
+  const user = await requireUser();
+  const membership = user.activeMembership;
+  if (!membership) {
+    redirect("/join");
+  }
+
+  const [stories, activity] = await Promise.all([
+    listVolunteerStoriesForChurch(membership.churchId),
+    listChurchActivity(membership.churchId),
+  ]);
+
+  const canWrite = membership.role === ROLES.VOLUNTEER || membership.role === ROLES.CHURCH_ADMIN;
+  const isChurchAdmin = membership.role === ROLES.CHURCH_ADMIN;
+  const now = new Date();
+
+  return (
+    <AuthShell user={user}>
+      <div className="mb-8">
+        <h1 className="text-2xl font-extrabold text-ink">Stories from {membership.church.name}</h1>
+        <p className="mt-1 max-w-2xl text-sm text-ink-muted">
+          The most persuasive thing a hesitant volunteer can read is what it was actually like for
+          someone who already did it — including the part where they were nervous.
+        </p>
+      </div>
+
+      <div className="grid gap-6 lg:grid-cols-3">
+        <div className="space-y-6 lg:col-span-2">
+          {canWrite && (
+            <Card>
+              <h2 className="flex items-center gap-2 font-bold text-ink">
+                <Quotes weight="fill" className="size-4.5 text-brand-600" />
+                Share what happened
+              </h2>
+              <p className="mt-1 mb-4 text-sm text-ink-muted">
+                A few sentences is plenty. Stays inside your church unless you tick the box.
+              </p>
+              <StoryForm />
+            </Card>
+          )}
+
+          {stories.length === 0 ? (
+            <EmptyState
+              icon={Quotes}
+              title="No stories yet"
+              body={
+                canWrite
+                  ? "Yours would be the first. Whoever hosted most recently probably has the best one."
+                  : "Once a volunteer here writes one, it'll show up here."
+              }
+            />
+          ) : (
+            <div className="space-y-4">
+              {stories.map((story) => (
+                <Card key={story.id}>
+                  <div className="flex items-start justify-between gap-4">
+                    <div className="flex items-center gap-3">
+                      <Avatar name={story.author.name} size="sm" />
+                      <div>
+                        <p className="text-sm font-semibold text-ink">{story.author.name}</p>
+                        <p className="text-xs text-ink-faint">
+                          {relativeTime(story.createdAt, now)}
+                        </p>
+                      </div>
+                    </div>
+                    {story.sharePublicly && (
+                      <Badge tone="brand" icon={Globe}>
+                        On the public page
+                      </Badge>
+                    )}
+                  </div>
+                  {/* whitespace-pre-line so a story written as two or three
+                      short paragraphs survives — these are typed into a
+                      textarea, not a rich editor. */}
+                  <p className="mt-4 whitespace-pre-line text-sm leading-relaxed text-ink-soft">
+                    {story.body}
+                  </p>
+                  <div className="mt-4">
+                    <StoryActions
+                      storyId={story.id}
+                      sharePublicly={story.sharePublicly}
+                      canToggle={story.authorId === user.id}
+                      canDelete={story.authorId === user.id || isChurchAdmin}
+                    />
+                  </div>
+                </Card>
+              ))}
+            </div>
+          )}
+        </div>
+
+        <div className="lg:col-span-1">
+          <Card>
+            <h2 className="flex items-center gap-2 font-bold text-ink">
+              <Users weight="fill" className="size-4.5 text-brand-600" />
+              What&apos;s been happening
+            </h2>
+            {activity.length === 0 ? (
+              <p className="mt-3 text-sm text-ink-muted">
+                Nothing yet. The first gathering on the calendar is what gets this moving.
+              </p>
+            ) : (
+              <ul className="mt-4 space-y-3">
+                {activity.map((item) => {
+                  const Icon = ACTIVITY_ICONS[item.kind] ?? ACTIVITY_ICONS[ACTIVITY_KINDS.RSVP];
+                  const line = (
+                    <span className="flex gap-2.5">
+                      <span className="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-lg bg-paper text-ink-muted">
+                        <Icon weight="fill" className="size-3.5" />
+                      </span>
+                      <span className="text-sm leading-snug text-ink-soft">
+                        <span className="font-semibold text-ink">{item.actor}</span> {item.summary}
+                        <span className="block text-xs text-ink-faint">
+                          {relativeTime(item.at, now)}
+                        </span>
+                      </span>
+                    </span>
+                  );
+                  return (
+                    <li key={item.id}>
+                      {item.href ? (
+                        <Link
+                          href={item.href}
+                          className="block rounded-lg transition-brand hover:opacity-80"
+                        >
+                          {line}
+                        </Link>
+                      ) : (
+                        line
+                      )}
+                    </li>
+                  );
+                })}
+              </ul>
+            )}
+          </Card>
+        </div>
+      </div>
+    </AuthShell>
+  );
+}
