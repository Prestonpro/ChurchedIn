+      churchId: church.id,
+      createdById: users.naomi.id,
+      createdAt: hoursAgo(6 * 24),
+    },
+  });
+
+  await prisma.eventRsvp.createMany({
+    data: [
+      { eventId: dinner.id, userId: users.grace.id, role: "HELPER", status: "CONFIRMED", createdAt: hoursAgo(5 * 24) },
+      { eventId: dinner.id, userId: users.ruth.id, role: "HELPER", status: "CONFIRMED", createdAt: hoursAgo(4 * 24) },
