+import type { Metadata } from "next";
+import { Path, ForkKnife } from "@phosphor-icons/react/dist/ssr";
+import { PublicHeader } from "@/components/nav/PublicHeader";
+import { FloatingShape } from "@/components/FloatingShape";
+import { Reveal } from "@/components/Reveal";
+import { TIER_ORDER, TIER_CONTENT } from "@/lib/readiness";
+import { ReadinessAssessment } from "./ReadinessAssessment";
+
+export const metadata: Metadata = {
+  title: "Where to start",
+  description:
+    "A short self-assessment that tells your church which of four places it's actually in — and the three next moves from there.",
+};
+
+/**
+ * The Readiness Pathway — the front door.
+ *
+ * Demo Day's clearest note was that "church" isn't a persona and that we had
+ * three overlapping ideas where we needed one. This page is the answer to
+ * both: the tiers are the reviewer's own three church types, and everything
+ * else we're building is what a church gets routed INTO from here rather
+ * than a separate product competing for the same summer.
+ */
+export default function ReadinessPage() {
+  return (
+    <div className="min-h-screen bg-paper">
+      <PublicHeader current="readiness" />
+
+      <section className="relative overflow-hidden bg-hero-mesh">
+        <FloatingShape position="left-[8%] top-[24%]" size="size-12" tone="bg-brand-300/35" scrollSpeed={0.06} />
+        <FloatingShape position="right-[10%] top-[16%]" size="size-9" tone="bg-accent-300/35" delay="2s" scrollSpeed={-0.08} />
+        <div className="relative mx-auto max-w-3xl px-6 pb-14 pt-16 text-center">
+          <Reveal variant="icon">
+            <span className="mx-auto flex size-12 items-center justify-center rounded-2xl bg-brand-600 text-white shadow-brand-glow">
+              <Path weight="fill" className="size-6" />
+            </span>
+          </Reveal>
+          <Reveal delay={100}>
+            <h1 className="mt-5 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
+              Not every church is at the same starting line.
+            </h1>
+          </Reveal>
+          <Reveal delay={200}>
+            <p className="mx-auto mt-4 max-w-xl text-lg text-ink-soft">
+              Six questions, no account, nothing saved. At the end you&apos;ll know which of four
+              places your church is actually in, and the three things worth doing next.
+            </p>
+          </Reveal>
+        </div>
+      </section>
+
+      <section className="border-y border-line bg-surface">
+        <div className="mx-auto max-w-5xl px-6 py-14">
+          <Reveal variant="left">
+            <h2 className="text-center text-2xl font-extrabold text-ink">The four places churches are in</h2>
+          </Reveal>
+          <Reveal delay={100}>
+            <p className="mx-auto mt-2 max-w-2xl text-center text-ink-muted">
+              Readiness isn&apos;t a score — it&apos;s a floor. You&apos;re at the earliest of these
+              that isn&apos;t true of you yet, because that&apos;s the one that will stall everything
+              built on top of it.
+            </p>
+          </Reveal>
+          <div className="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
+            {TIER_ORDER.map((tier, index) => {
+              const content = TIER_CONTENT[tier];
+              return (
+                <Reveal key={tier} delay={index * 90} className="h-full">
+                  <div
+                    className={`flex h-full flex-col rounded-2xl border bg-surface p-5 shadow-card ${
+                      content.graduatesToChurchedIn ? "border-brand-200" : "border-line"
+                    }`}
+                  >
+                    <span className="text-xs font-extrabold uppercase tracking-wider text-ink-faint">
+                      Tier {index + 1}
+                    </span>
+                    <h3 className="mt-2 text-base font-bold text-ink">{content.label}</h3>
+                    <p className="mt-2 grow text-sm text-ink-muted">{content.summary}</p>
+                    {content.graduatesToChurchedIn && (
+                      <span className="mt-4 inline-flex w-fit items-center rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700">
+                        Ready for ChurchedIn
+                      </span>
+                    )}
+                  </div>
+                </Reveal>
+              );
+            })}
+          </div>
+        </div>
+      </section>
+
+      <section className="mx-auto max-w-3xl px-6 py-16">
+        <Reveal variant="left">
+          <h2 className="text-2xl font-extrabold text-ink">Where is your church?</h2>
+        </Reveal>
+        <Reveal delay={100}>
+          <p className="mt-2 text-ink-muted">
+            Answer for the church as it is today, not as you hope it will be in September. The
+            honest answer is the useful one.
+          </p>
+        </Reveal>
+        <div className="mt-8">
+          <ReadinessAssessment />
+        </div>
+      </section>
+
+      <footer className="border-t border-line px-6 py-10 text-center text-sm text-ink-muted">
+        <span className="inline-flex items-center gap-1.5">
+          <ForkKnife weight="fill" className="size-4" /> Made with love for church communities
+          welcoming students far from home.
+        </span>
+      </footer>
+    </div>
+  );
+}
