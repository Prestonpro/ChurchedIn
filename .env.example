DATABASE_URL="file:./dev.db"

# Used to sign session cookies. Generate a real value for any real deployment:
# openssl rand -hex 32
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Base URL used to build links in emails (event links, etc.)
APP_URL="http://localhost:3000"

# Optional: set both to switch src/lib/email.ts from console logging to real
# Resend delivery. Get RESEND_API_KEY from https://resend.com/api-keys.
# Until you verify your own sending domain in Resend, EMAIL_FROM must stay
# on Resend's shared test domain (onboarding@resend.dev) and Resend will
# only actually deliver to the email address on your own Resend account —
# not to arbitrary user emails. See README.md's Email setup section.
# RESEND_API_KEY=""
# EMAIL_FROM="Church LinkedIn <onboarding@resend.dev>"
