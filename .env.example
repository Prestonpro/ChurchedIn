DATABASE_URL="file:./dev.db"

# Used to sign session cookies. Generate a real value for any real deployment:
# openssl rand -hex 32
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Base URL used to build links in emails (verification, connection requests, etc.)
APP_URL="http://localhost:3000"

# Optional: set to switch src/lib/email.ts from console logging to Resend.
# RESEND_API_KEY=""
