# Postgres connection string. See DEPLOYMENT.md for how to provision one on
# Neon (recommended — free tier, serverless, built-in Vercel integration).
# Use the *pooled* connection string Neon gives you (hostname contains
# "-pooler") — this app runs fine against it directly for both the app
# runtime and `prisma migrate`.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Direct (unpooled) connection — same credentials, hostname just drops
# "-pooler". Required for `prisma migrate ...` commands: Neon's PgBouncer
# transaction-pooling mode can't reliably support the Postgres advisory lock
# migrations take. See https://pris.ly/d/migrate-advisory-locking
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Used to sign session cookies. Generate a real value for any real deployment:
# openssl rand -hex 32
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Base URL used to build links in emails (event links, etc.)
APP_URL="http://localhost:3000"

# Optional: set both to switch src/lib/email.ts from console logging to real
# Resend delivery. Get RESEND_API_KEY from https://resend.com/api-keys.
# Until you verify your own sending domain in Resend, EMAIL_FROM must stay
# on Resend's shared test domain (onboarding@resend.dev) and Resend will
# only actually deliver to the email address on your own Resend account —
# not to arbitrary user emails. See README.md's Email setup section.
# RESEND_API_KEY=""
# EMAIL_FROM="ChurchedIn <onboarding@resend.dev>"

# Google OAuth ("Sign in with Google"). Get these from Google Cloud Console
# → APIs & Services → Credentials → Create Credentials → OAuth Client ID
# (type "Web application"). Authorized redirect URI must be exactly
# {APP_URL}/api/auth/callback/google — e.g. http://localhost:3000/api/auth/callback/google
# in dev, or https://your-domain.com/api/auth/callback/google in production.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
